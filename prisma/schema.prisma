generator client {
    provider        = "prisma-client-js"
    binaryTargets   = ["native", "rhel-openssl-3.0.x"]
    previewFeatures = ["postgresqlExtensions"]
}

datasource db {
    provider   = "postgresql"
    url        = env("DATABASE_URL")
    extensions = [vector]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  /// Papel do usuário. Valores aceitos:
  ///   - "admin"           — legado, equivalente a DPO_PRINCIPAL + super-admin
  ///                         (mantido pro usuário inicial pré-migração)
  ///   - "DPO_PRINCIPAL"   — encarregado titular da organização (1 por org)
  ///   - "DPO_SUBSTITUTO"  — substituto do principal (1 por org)
  ///   - "DPO_AUXILIAR"    — auxiliar; vê tudo, aprova, sem poder de criar
  ///                         contribuidor (N por org)
  ///   - "CONTRIBUIDOR"    — preenche processos do próprio setor (N)
  ///   - "user"            — legado pra contas antigas
  /// Helpers em `lib/auth-helpers.ts` centralizam as checagens.
  role          String    @default("CONTRIBUIDOR")
  /// Setor / departamento do usuário (texto livre — RH, Ouvidoria, etc.).
  /// Usado principalmente pra Contribuidores; opcional pra DPOs.
  setor         String?
  isActive      Boolean   @default(false) // Novo usuário precisa ser ativado pelo admin
  accounts      Account[]
  sessions      Session[]

  // Relacionamento com empresa
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id])

  // Quem cadastrou este usuário (DPO que criou a conta de Contribuidor).
  // null = usuário criado pelo super-admin ou pré-migração.
  invitedById   String?
  invitedBy     User?     @relation("InvitedUsers", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers  User[]    @relation("InvitedUsers")

  // Recuperação de senha
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?

  // Progresso do checklist RIPD
  ripdChecklistProgress RipdChecklistProgress?

  // Conversas do chatbot
  chatConversations ChatConversation[]

  // Inventários criados/revisados por este usuário
  createdInventories  DataInventory[] @relation("InventoryCreatedBy")
  reviewedInventories DataInventory[] @relation("InventoryReviewedBy")
  legalReviewedInventories DataInventory[] @relation("LegalReviewedBy")

  // Riscos identificados/revisados por este usuário (Análise de Riscos)
  identifiedRisks ProcessRisk[] @relation("RiskIdentifiedBy")
  reviewedRisks   ProcessRisk[] @relation("RiskReviewedBy")

  // Tarefas pessoais (caderno individual de cada usuário)
  tasks         Task[]
  taskMarkers   TaskMarker[]

  // Fórum + Mensagens (visibilidade compartilhada da org)
  authoredForumPosts  ForumPost[] @relation("ForumPostAuthor")
  receivedForumPosts  ForumPost[] @relation("ForumPostRecipient") // só DMs
  authoredForumReplies ForumReply[]
  forumReads          ForumPostRead[]

  // GAP Analysis (Checkpoint 9) — quem respondeu cada controle e quem
  // congelou os snapshots
  gapAnswered   GapAnswer[]
  gapSnapshots  GapSnapshot[]

  // Plano de Ação institucional (Checkpoint 11) — ações onde sou
  // responsável vs onde criei
  assignedActions ActionPlan[] @relation("AssignedActions")
  createdActions  ActionPlan[] @relation("CreatedActions")

  // Políticas (Checkpoint 12) — quem criou e quem publicou cada
  // política/versão
  createdPolicies   Policy[]        @relation("PolicyCreatedBy")
  publishedPolicies Policy[]        @relation("PolicyPublishedBy")
  publishedVersions PolicyVersion[] @relation("PolicyVersionPublishedBy")

  // RIPD (Checkpoint 13) — quem criou, aprovou e congelou cada versão
  createdRipds         Ripd[]        @relation("RipdCreatedBy")
  approvedRipds        Ripd[]        @relation("RipdApprovedBy")
  approvedRipdVersions RipdVersion[] @relation("RipdVersionApprovedBy")

  // Gestão de Terceiros (Checkpoint 14) — operadores que cadastrei e
  // operadores onde sou o responsável interno
  createdOperators     Operator[]    @relation("OperatorCreatedBy")
  responsibleOperators Operator[]    @relation("OperatorResponsible")
  // Avaliações de terceiros (G2) — quem criou e quem revisou
  createdAssessments   OperatorAssessment[] @relation("AssessmentCreatedBy")
  reviewedAssessments  OperatorAssessment[] @relation("AssessmentReviewedBy")

  // Incidentes (Checkpoint 16) — quem registrou, quem encerrou, e quem
  // gerou comunicações pra ANPD/titulares.
  createdIncidents       Incident[]              @relation("IncidentCreatedBy")
  closedIncidents        Incident[]              @relation("IncidentClosedBy")
  incidentCommunications IncidentCommunication[] @relation("IncidentCommGeneratedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Company {
  id                String   @id @default(cuid())
  companyName       String
  /// Slug único da org pra usar em URLs públicas (ex: /p/<slug>/privacidade).
  /// Se null, a página pública não funciona — só rota interna. Gerado de
  /// `companyName` no primeiro acesso à tela de Políticas (Checkpoint 12).
  slug              String?  @unique
  tradeName         String?
  cnpj              String?  @unique
  address           String?
  city              String?
  state             String?
  zipCode           String?
  phone             String?
  email             String?
  website           String?
  logoUrl           String?
  legalRepresentative String?
  dpoName           String?  // Data Protection Officer/Encarregado
  dpoEmail          String?
  dpoPhone          String?
  businessSector    String?
  employeesCount    Int?
  ripdEbookUrl      String?  // URL do ebook Heyzine para RIPD
  
  // Usuários da empresa
  users             User[]
  
  // Documentos e inventários relacionados
  dataInventories   DataInventory[]
  processRisks      ProcessRisk[]
  tasks             Task[]
  taskMarkers       TaskMarker[]
  forumPosts        ForumPost[]
  riskAssessments   RiskAssessment[]
  // GAP Analysis (Checkpoint 9)
  gapAnswers        GapAnswer[]
  gapSnapshots      GapSnapshot[]
  actionPlans       ActionPlan[]
  policies          Policy[]
  ripds            Ripd[]
  operators        Operator[]
  documents        Document[]
  incidents        Incident[]
  phaseDocuments   PhaseDocument[]
  phaseInfos       PhaseInfo[]
  phaseEbooks      PhaseEbook[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

model DataInventory {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  serviceName     String
  dataCategory    String   // Categorias como "dados pessoais sensíveis", "dados pessoais", etc.
  personalData    String   // Tipos de dados coletados
  legalBasis      String   // Base legal para tratamento
  purpose         String   // Finalidade do tratamento
  dataSubjects    String   // Titulares dos dados
  retention       String   // Período de retenção
  storage         String   // Local de armazenamento
  sharing         String?  // Compartilhamento com terceiros
  security        String   // Medidas de segurança

  // Respostas completas do wizard de mapeamento (formato JSON tipado por
  // lib/inventario-form-schema.ts). Quando preenchido, é a fonte de
  // verdade — os campos String acima são derivados como resumo.
  // Estrutura: { respondent: {...}, sections: { sec2: {...}, ..., sec7: {...} } }
  formAnswers     Json?
  // Marca se o registro ainda é rascunho (wizard não concluído).
  // DEPRECATED em favor de `status` — mantido pra compatibilidade. Será
  // removido num checkpoint futuro depois que toda a UI usar `status`.
  isDraft         Boolean  @default(false)

  /// Status do processo no fluxo de aprovação. Valores:
  ///   - "RASCUNHO"   — Contribuidor preenchendo (não submetido ainda)
  ///   - "SUBMETIDO"  — Contribuidor submeteu pra revisão
  ///   - "EM_REVISAO" — DPO está revisando
  ///   - "APROVADO"   — DPO aprovou; entra na Análise de Riscos
  ///   - "DEVOLVIDO"  — DPO devolveu pra ajustes (com comentário)
  status          String   @default("RASCUNHO")

  /// Setor responsável (RH, Ouvidoria, etc.). Geralmente igual ao setor
  /// do usuário criador. Cacheado aqui pra facilitar filtros.
  setor           String?

  /// Usuário que criou o processo (Contribuidor da área).
  createdById     String?
  createdBy       User?    @relation("InventoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Usuário (DPO) que revisou o processo.
  reviewedById    String?
  reviewedBy      User?    @relation("InventoryReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  /// Comentário do DPO ao devolver pra ajustes (status DEVOLVIDO).
  reviewComment   String?  @db.Text

  // ---------- Bases Legais (preenchido pelo DPO/jurídico após o mapeamento) ----------
  // Esses 4 campos correspondem às colunas J, K, L, M do Excel modelo.
  // O wizard do contribuidor não preenche isso — fica em branco pro
  // DPO complementar via tela dedicada.
  /// Previsão Legal — Lei/norma que obriga o tratamento (Excel coluna J)
  previsaoLegal       String?  @db.Text
  /// Base Legal aplicável a Dados Pessoais Sensíveis (Excel coluna K)
  legalBasisSensitive String?
  /// Comentários sobre as Bases Legais sugeridas (Excel coluna M)
  legalBasisComments  String?  @db.Text
  /// Quem do jurídico/DPO preencheu as bases legais
  legalReviewedById   String?
  legalReviewedBy     User?    @relation("LegalReviewedBy", fields: [legalReviewedById], references: [id], onDelete: SetNull)
  legalReviewedAt     DateTime?

  // ---------- Análise de Riscos (Checkpoint 5) ----------
  // 1 processo aprovado pode ter de 0 a 13 riscos identificados.
  // Cada ProcessRisk corresponde a uma "x" das colunas BR-CD do Excel modelo.
  // Campos detalhados (severityLevel, mitigationPlan) ficam null até o
  // Checkpoint 6 — Detalhamento de Riscos.
  processRisks ProcessRisk[]

  // Tarefas pessoais opcionalmente vinculadas a este processo
  // ("Atualizar política do Sistema X", "Conferir compartilhamento Y").
  tasks Task[]

  // RIPDs gerados a partir deste processo (Checkpoint 13). Cada
  // processo pode ter 0..N RIPDs (raro ter mais de 1 ativo, mas
  // versões + arquivados acumulam).
  ripds Ripd[]

  // Operadores/Terceiros vinculados a este processo (Checkpoint 14).
  // Cada vínculo descreve qual atividade o operador faz no processo.
  operatorLinks OperatorProcessLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("data_inventories")
  @@index([companyId, status])
  @@index([companyId, setor])
}

/// Risco identificado num processo de tratamento específico (DataInventory).
///
/// 1 linha aqui = 1 marcação "x" do consultor numa coluna BR-CD do Excel
/// modelo de Mapeamento. Usado pela tela de Análise de Riscos (DPO-only).
///
/// Estrutura preparada pro Checkpoint 6 (Detalhamento): os campos
/// `severityLevel`, `description`, `mitigationPlan` e `legalBasisRef`
/// ficam null no Checkpoint 5 e serão preenchidos depois pelo DPO numa
/// tela de detalhe (1 risco por vez), conforme metodologia da Denise:
/// FATO → FUNDAMENTO LEGAL → RISCO IDENTIFICADO → RECOMENDAÇÕES.
model ProcessRisk {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dataInventoryId String
  dataInventory   DataInventory @relation(fields: [dataInventoryId], references: [id], onDelete: Cascade)

  /// Código do risco — 1 dos 13 tipos da metodologia LGPD PRO. Mapeia
  /// 1-pra-1 com as colunas BR-CD do Excel:
  ///   BR=ausencia_legitimacao · BS=criancas_adolescentes
  ///   BT=excessivo · BU=falta_transparencia · BV=transferencia_internacional
  ///   BW=compartilhamento_terceiro · BX=armazenagem_indeterminada
  ///   BY=finalidade_diversa · BZ=compartilhamento_grupo
  ///   CA=aquisicao_indireta · CB=decisao_automatizada · CC=profiling
  ///   CD=background_check
  riskCode        String

  /// Estado do ciclo de vida do risco:
  ///   - "IDENTIFICADO"  — DPO marcou; ainda sem plano (default)
  ///   - "EM_MITIGACAO"  — Plano de ação em execução
  ///   - "ACEITO"        — Empresa decidiu seguir mesmo com o risco
  ///   - "ELIMINADO"     — Mitigação aplicada e confirmada
  status          String   @default("IDENTIFICADO")

  /// Observação curta livre — equivalente ao texto inline na coluna BR-CD do
  /// Excel (ex: BV "Estados Unidos" pra transferência internacional).
  description     String?  @db.Text

  /// Indica se a marcação foi sugerida automaticamente pelo sistema (com
  /// base nas respostas do wizard) e depois confirmada pelo DPO.
  /// Usado pra trilha de auditoria — mostra o que foi humano vs automático.
  autoSuggested   Boolean  @default(false)

  // ---------- Campos pro Checkpoint 6 (Detalhamento) ----------
  // Ficam null no Checkpoint 5; preenchidos depois.
  /// Classificação combinada Severidade × Probabilidade: "BAIXO" | "MEDIO" | "ALTO"
  severityLevel   String?
  /// Plano de mitigação detalhado (texto livre + medidas marcadas)
  mitigationPlan  String?  @db.Text
  /// Referência legal específica (artigo/inciso da LGPD aplicável)
  legalBasisRef   String?

  // ---------- Auditoria ----------
  identifiedById  String?
  identifiedBy    User?    @relation("RiskIdentifiedBy", fields: [identifiedById], references: [id], onDelete: SetNull)
  identifiedAt    DateTime @default(now())
  reviewedById    String?
  reviewedBy      User?    @relation("RiskReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([dataInventoryId, riskCode])
  @@index([companyId, status])
  @@index([dataInventoryId])
  @@map("process_risks")
}

/// Tarefa pessoal de um usuário (caderno individual de planejamento).
///
/// Origem: inspirada no `TarefaValidador` do RADAR PNTP. Aqui ficou bem
/// mais enxuta — sem KPIs semanais, sem drag-and-drop, sem cron de e-mail
/// (notificação é só visual no app).
///
/// Visibilidade: PRIVADA — só o dono vê e edita as próprias tarefas.
/// `companyId` está aqui só pra isolamento multi-tenant na cascade
/// (se a org for excluída, as tarefas dos seus membros somem junto).
model Task {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title           String   @db.VarChar(200)
  description     String?  @db.Text

  /// "A_FAZER" | "EM_ANDAMENTO" | "CONCLUIDA"
  status          String   @default("A_FAZER")
  /// "BAIXA" | "MEDIA" | "ALTA"
  priority        String   @default("MEDIA")

  /// Data de prazo (sem horário — Date only). Tarefas sem prazo ficam null.
  dueDate         DateTime?

  /// Marcadores aplicados a esta tarefa: JSON com array de nomes
  /// (ex: '["Urgente","Reunião"]'). Os nomes referenciam TaskMarker do
  /// próprio dono. Limite prático: 10 por tarefa.
  markers         String?  @db.Text

  /// Vínculo opcional com um processo aprovado do Inventário
  /// (ex: "Atualizar retenção do Sistema de CRM"). Se o processo for
  /// excluído, o vínculo é zerado mas a tarefa permanece.
  dataInventoryId String?
  dataInventory   DataInventory? @relation(fields: [dataInventoryId], references: [id], onDelete: SetNull)

  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([companyId])
  @@map("tasks")
}

/// Marcador (tag) personalizado pra organizar tarefas. Cada usuário tem
/// o próprio conjunto, com nome único. Cor é uma das 6 da paleta.
model TaskMarker {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name      String   @db.VarChar(60)
  /// "slate" | "indigo" | "amber" | "red" | "emerald" | "fuchsia"
  color     String   @default("slate")

  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
  @@map("task_markers")
}

/// Posts do fórum + mensagens diretas (1 modelo só pros 2 conceitos —
/// igual ao RADAR PNTP, mais elegante que duplicar).
///
/// `recipientId` distingue:
///   - null         → post PÚBLICO visível pra toda a organização
///   - preenchido   → mensagem direta 1-pra-1 (só autor + recipient veem)
///
/// `type`:
///   - "DISCUSSION"   → post comum (todos os papéis criam)
///   - "ANNOUNCEMENT" → comunicado oficial (só DPO cria; pode fixar)
///
/// `category` (só pros públicos): "GERAL" | "INVENTARIO" | "RISCOS" |
/// "BASES_LEGAIS" | "DUVIDA".
///
/// `active` é soft-delete: ao "excluir", marca como false. Posts inativos
/// não aparecem nas listas mas ficam pra auditoria.
model ForumPost {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  authorId     String
  author       User     @relation("ForumPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  /// Mensagem direta: id do destinatário. Null = post público.
  recipientId  String?
  recipient    User?    @relation("ForumPostRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  /// "DISCUSSION" | "ANNOUNCEMENT"
  type         String   @default("DISCUSSION")
  /// "GERAL" | "INVENTARIO" | "RISCOS" | "BASES_LEGAIS" | "DUVIDA"
  /// Null em mensagens diretas (não fazem sentido categorizadas).
  category     String?
  title        String   @db.VarChar(200)
  content      String   @db.Text

  /// Apenas DPO pode fixar/desafixar. Posts fixados aparecem no topo.
  pinned       Boolean  @default(false)
  /// Soft delete — false = oculto da UI mas mantido no banco.
  active       Boolean  @default(true)

  replies      ForumReply[]
  reads        ForumPostRead[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, recipientId])
  @@index([companyId, pinned, createdAt])
  @@index([companyId, category])
  @@index([authorId])
  @@index([recipientId])
  @@map("forum_posts")
}

/// Resposta a um ForumPost (1 nível — sem threads aninhadas).
model ForumReply {
  id        String   @id @default(cuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([authorId])
  @@map("forum_replies")
}

/// Marca quando cada usuário leu cada post (pra contagem de não-lidos).
model ForumPostRead {
  id      String   @id @default(cuid())
  postId  String
  post    ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt  DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
  @@map("forum_post_reads")
}

model RiskAssessment {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  processName     String
  riskDescription String
  likelihood      String   // "Baixo", "Médio", "Alto"
  impact          String   // "Baixo", "Médio", "Alto"
  riskLevel       String   // "Baixo", "Médio", "Alto", "Crítico"
  controls        String   // Controles existentes
  recommendations String   // Recomendações de melhoria
  responsibleArea String
  deadline        DateTime?
  status          String   @default("Pendente")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("risk_assessments")
}

/// Resposta de 1 controle do GAP Analysis (Checkpoint 9) — replica
/// 1 LINHA do template oficial "Matriz de Controles e Avaliação de Gaps"
/// (XLSX em `scripts/_gap-modelo-em-branco.xlsx`).
///
/// O catálogo dos 119 controles fica em `lib/gap-catalog.ts` (gerado por
/// `scripts/generate-gap-catalog.ts` a partir do XLSX). Esta tabela só
/// guarda as RESPOSTAS — os textos de pergunta/artigo/instrução vêm do
/// catálogo em código.
///
/// Granularidade: cada `controlCode` (estável, ex: "001"-"119") representa
/// 1 pergunta marcável (incluindo sub-perguntas condicionais e itens
/// individuais de checkbox — todos podem receber resposta no template).
///
/// Visibilidade: só DPO (Principal/Substituto/Auxiliar) preenche.
/// 1 GapAnswer "ativo" por (companyId, controlCode); versões congeladas
/// vão pra `GapSnapshot`.
model GapAnswer {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Código estável do controle no catálogo (ex: "001", "048", "119").
  /// Referência: `lib/gap-catalog.ts::GAP_CONTROLS`. Não é FK — o
  /// catálogo vive em código (versionado pelo git).
  controlCode  String

  /// Coluna H do XLSX — "Cenário Atual" (texto livre descrevendo a
  /// situação real da organização pra esse controle).
  cenarioAtual String?  @db.Text

  /// Coluna I do XLSX — "Mapeamento". Valores aceitos:
  ///   "NAO_INICIADO" | "EM_ANDAMENTO" | "FINALIZADO"
  mapeamento   String?

  /// Coluna J do XLSX — "Aderência". Valores aceitos:
  ///   "ADERENTE" | "PARCIAL" | "NAO_ADERENTE" | "NA"
  aderencia    String?

  /// Coluna K do XLSX — "Ponto de Melhoria" (texto livre). Vira insumo
  /// pra criar Tasks pessoais (bloco 8b da decisão).
  pontoMelhoria String? @db.Text

  /// Notas/observações livres do DPO sobre esse controle. Não vai pro
  /// XLSX exportado; é um espaço pra registrar contexto interno (links,
  /// decisões em andamento, citações de outras políticas, etc.) que
  /// não cabe nos 4 campos formais do template.
  notes         String? @db.Text

  /// Indica se o valor foi pré-preenchido pelo auto-suggest baseado no
  /// Inventário (decisão 5b) e ainda não foi confirmado pelo DPO.
  /// Vira `false` assim que o DPO salvar manualmente o controle.
  autoSuggested Boolean @default(false)

  /// DPO que respondeu por último.
  answeredById String?
  answeredBy   User?    @relation(fields: [answeredById], references: [id], onDelete: SetNull)
  answeredAt   DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([companyId, controlCode])
  @@index([companyId, mapeamento])
  @@index([companyId, aderencia])
  @@map("gap_answers")
}

/// Snapshot congelado do GAP Analysis (decisão 2c) — captura todas as
/// respostas + perfil/aplicabilidade num ponto no tempo. Usado pra
/// histórico de versões e pra Exportar Excel reproduzindo o estado
/// daquela data (decisão 10b).
model GapSnapshot {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Rótulo curto livre dado pelo DPO ao congelar (ex: "Diagnóstico
  /// inicial 2026-Q2"). Default: "Snapshot dd/mm/aaaa".
  label       String   @db.VarChar(120)

  /// Comentário opcional do DPO sobre essa versão.
  notes       String?  @db.Text

  /// Cópia congelada de todos os GapAnswer da empresa no momento da
  /// criação. Estrutura: { answers: GapAnswer[], stats: {...},
  /// generatedAt: ISO } — enxuto, só os dados de resposta (sem o catálogo,
  /// que é fixo em código).
  payload     Json

  /// DPO que criou o snapshot.
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("gap_snapshots")
}

/// Plano de Ação institucional — diferente das `Task` (que são pessoais).
/// Lista oficial das ações que a organização precisa executar pra adequação
/// LGPD, com responsável formal, prazo, prioridade. Pode ser criado
/// manualmente pelo DPO ou auto-importado de:
///   - GAP (controles NAO_ADERENTE/PARCIAL com Ponto de Melhoria)
///   - Riscos (status IDENTIFICADO sem mitigação)
///   - Bases Legais (processos APROVADOS sem base legal)
///   - Operadores (contrato vencido / sem cláusulas / score ALTO / formulário pendente)
///
/// Refs polimórficos (`refGapCode`/`refRiskId`/`refInventoryId`/`refOperatorId`):
/// só 1 fica preenchido por linha, conforme `origin`. Quando `origin = MANUAL`,
/// todas as refs ficam null.
model ActionPlan {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Conteúdo da ação
  title       String
  description String? @db.Text
  notes       String? @db.Text

  /// Origem: MANUAL | GAP | RISCO | BASES | OPERADOR | INCIDENTE
  origin      String  @default("MANUAL")
  /// Refs polimórficos pra rastrear de onde a ação saiu
  refGapCode      String? // GapAnswer.controlCode
  refRiskId       String? // ProcessRisk.id
  refInventoryId  String? // DataInventory.id
  refOperatorId   String? // Operator.id (Checkpoint 14 G4)
  refIncidentId   String? // Incident.id (Checkpoint 16 F1)
  refIncident     Incident? @relation("ActionPlanIncident", fields: [refIncidentId], references: [id], onDelete: SetNull)

  /// Responsável formal (User da org); null = ainda sem responsável
  assigneeId  String?
  assignee    User?   @relation("AssignedActions", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Prazo (data limite) e prioridade ALTA|MEDIA|BAIXA
  dueDate     DateTime?
  priority    String   @default("MEDIA")

  /// Ciclo de vida: A_FAZER | EM_ANDAMENTO | CONCLUIDA | CANCELADA
  status      String   @default("A_FAZER")
  completedAt DateTime?

  /// Auditoria — quem criou (DPO)
  createdById String
  createdBy   User     @relation("CreatedActions", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId, assigneeId])
  @@index([companyId, dueDate])
  @@index([companyId, refOperatorId])
  @@index([companyId, refIncidentId])
  @@map("action_plans")
}

/// Políticas LGPD da organização (Checkpoint 12). Documentos jurídicos
/// gerados a partir de templates: política de privacidade externa
/// (site), política interna, termos de uso, política de cookies, etc.
///
/// Cada `Policy` é um documento "vivo" com 1 conteúdo de rascunho e
/// histórico de versões publicadas (`PolicyVersion`). Quando o DPO
/// publica, snapshot do `currentContent` vira nova `PolicyVersion` e
/// `publishedContent` é atualizado.
///
/// `slug` é único por (companyId, type) — pra construir URL pública
/// `/p/<companySlug>/<policySlug>` (ex: `/p/lgpd-pgp/privacidade`).
model Policy {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Tipo da política — define template inicial e tela pública. Enum:
  /// AVISO_PRIVACIDADE_EXTERNO | POLITICA_PRIVACIDADE_INTERNO |
  /// NORMA_PRIVACIDADE | TERMOS_USO | POLITICA_COOKIES |
  /// POLITICA_TERCEIROS | POLITICA_RETENCAO | POLITICA_TREINAMENTO |
  /// POLITICA_TRANSFERENCIA | OUTRA
  type        String

  title       String
  /// Slug interno desta política (pra URL pública). Único por (company, type).
  slug        String

  /// Status: RASCUNHO | PUBLICADA | ARQUIVADA
  status      String  @default("RASCUNHO")

  /// Conteúdo de rascunho (markdown). Sempre editável.
  currentContent  String  @db.Text
  /// Conteúdo publicado (snapshot da última publicação). null se nunca
  /// foi publicada. Vai pra URL pública.
  publishedContent String? @db.Text

  /// Versão atual publicada (number). Increment a cada `publish`.
  currentVersion  Int     @default(0)

  /// Auditoria de publicação
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?     @relation("PolicyPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  /// Quem criou
  createdById String
  createdBy   User     @relation("PolicyCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Histórico de versões publicadas
  versions    PolicyVersion[]

  @@unique([companyId, type, slug])
  @@index([companyId, status])
  @@index([companyId, type])
  @@map("policies")
}

/// Snapshot de uma versão publicada de Policy. Cada `publish` cria 1
/// linha aqui — preserva o que foi publicado em cada momento, pra
/// auditoria, comparação e possível rollback.
model PolicyVersion {
  id          String  @id @default(cuid())
  policyId    String
  policy      Policy  @relation(fields: [policyId], references: [id], onDelete: Cascade)

  /// Número da versão (1, 2, 3, ...)
  version     Int
  /// Conteúdo congelado (markdown)
  content     String  @db.Text
  /// Changelog opcional (DPO descreve o que mudou)
  changeLog   String?

  publishedAt   DateTime @default(now())
  publishedById String
  publishedBy   User     @relation("PolicyVersionPublishedBy", fields: [publishedById], references: [id])

  @@unique([policyId, version])
  @@index([policyId, publishedAt])
  @@map("policy_versions")
}

/// Relatório de Impacto à Proteção de Dados Pessoais — RIPD
/// (Checkpoint 13). Documento institucional que descreve um processo
/// de tratamento que pode gerar risco alto aos titulares, exigido pela
/// LGPD (arts. 5º XVII, 38) e regulamentado pela Resolução CD/ANPD
/// nº 2/2022.
///
/// Cada Ripd é vinculado (opcional) a um `DataInventory` aprovado que
/// serve de fonte pra pré-população das 8 seções (engine em
/// `lib/ripd-prepopulate.ts`).
///
/// Fluxo de aprovação:
///   - Contribuidor cria → RASCUNHO; pode editar e "enviar pra
///     revisão" (EM_REVISAO)
///   - DPO em RASCUNHO/EM_REVISAO próprio: aprova diretamente
///   - DPO em EM_REVISAO de Contribuidor: aprova ou rejeita com
///     `rejectionNote` (volta pra RASCUNHO)
///   - Aprovação cria `RipdVersion` (snapshot) e atualiza
///     `publishedContent` + `publishedAt` + `publishedVersionNum`
///
/// Estrutura do `data` (JSON): tipada por `RipdData` em
/// `lib/ripd-helpers.ts` — 8 seções fixas (s1..s8).
model Ripd {
  id                  String         @id @default(cuid())
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Processo do Inventário origem dos dados (opcional — RIPDs avulsos
  /// permitidos, mas o normal é ter). SetNull se o processo for excluído.
  inventoryId         String?
  inventory           DataInventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  title               String

  /// "RASCUNHO" | "EM_REVISAO" | "APROVADO" | "ARQUIVADO"
  status              String         @default("RASCUNHO")

  /// Conteúdo das 8 seções — ver RipdData em lib/ripd-helpers.ts
  data                Json

  /// Nota do DPO ao rejeitar (volta pra RASCUNHO).
  rejectionNote       String?        @db.Text

  // ---------- Aprovação ----------
  approvedById        String?
  approvedBy          User?          @relation("RipdApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt          DateTime?

  // ---------- Versionamento (snapshot a cada aprovação) ----------
  publishedContent    Json?
  publishedAt         DateTime?
  publishedVersionNum Int?
  versions            RipdVersion[]

  // ---------- Auditoria ----------
  createdById         String
  createdBy           User           @relation("RipdCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([companyId, status])
  @@index([companyId, createdById])
  @@index([inventoryId])
  @@map("ripds")
}

/// Snapshot de uma versão aprovada do Ripd. 1 linha = 1 aprovação.
/// Preserva o conteúdo congelado pra histórico, comparação e rollback.
model RipdVersion {
  id           String   @id @default(cuid())
  ripdId       String
  ripd         Ripd     @relation(fields: [ripdId], references: [id], onDelete: Cascade)

  /// Número da versão (1, 2, 3, ...)
  version      Int
  /// Conteúdo congelado (mesma estrutura JSON do Ripd.data)
  content      Json
  /// Changelog opcional descrito pelo DPO ao aprovar.
  changeLog    String?  @db.Text

  approvedAt   DateTime @default(now())
  approvedById String
  approvedBy   User     @relation("RipdVersionApprovedBy", fields: [approvedById], references: [id])

  @@unique([ripdId, version])
  @@index([ripdId, approvedAt])
  @@map("ripd_versions")
}

/// Operador / Terceiro / Fornecedor — Gestão de Terceiros (Checkpoint 14).
///
/// Inspirado na metodologia da Denise (consultoria PGP) — substitui o
/// inventário-de-terceiros em XLSX por entidade estruturada com régua
/// de risco automatizada (6 critérios ANPD), checklist de cláusulas
/// LGPD, vínculo com processos do Inventário, e workflow de avaliação.
///
/// Posição (`relationType`):
///   - "INDEFINIDO"      — encarregado ainda não classificou
///   - "OPERADOR"        — terceiro trata dados em nome da Company
///   - "CONTROLADOR"     — terceiro é outro controlador
///   - "CO_CONTROLADOR"  — controladoria conjunta (decisões comuns/convergentes)
///
/// Régua de risco do CONTRATO (6 critérios ANPD — não confundir com
/// avaliação do operador via Formulário em G2):
///   - Critério geral:    largaEscala + afetaTitulares
///   - Critério específico: novasTecnologias + vigilanciaPublica +
///                          decisaoAutomatizada + dadosSensiveis
///   - Cálculo: geral × específico ≥ 1 → ALTO;
///              geral OU específico ≥ 1 → MEDIO; nenhum → BAIXO
///
/// Cláusula recomendada: derivada de (relationType + contractRiskClass)
/// — engine em `lib/operadores-risco-contrato.ts`. Templates em G3.
model Operator {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ----- Identificação -----
  /// Razão social do terceiro
  name            String
  tradeName       String?
  cnpj            String?
  /// País sede (pra detectar transferência internacional). Default "Brasil".
  country         String?  @default("Brasil")
  /// Categorização livre (CLOUD/PAGAMENTOS/MARKETING/RH/AUDITORIA/
  /// LOGISTICA/TI/JURIDICO/SAUDE/OUTRO). Apenas pra filtros — não
  /// influencia regras.
  operatorType    String?
  description     String?  @db.Text
  notes           String?  @db.Text

  // ----- Posição na relação (decisão 5: checklist + DPO confirma) -----
  /// "INDEFINIDO" | "OPERADOR" | "CONTROLADOR" | "CO_CONTROLADOR"
  relationType    String   @default("INDEFINIDO")
  /// Respostas do checklist de classificação (auto-sugestão).
  /// Estrutura: { o1: bool, o2: bool, ..., c1: bool, ... }
  /// Detalhe das perguntas em `lib/operadores-helpers.ts`.
  classificationAnswers Json?

  // ----- Contato do terceiro (DPO/responsável LGPD) -----
  thirdPartyDpoName  String?
  thirdPartyDpoEmail String?
  thirdPartyDpoPhone String?

  // ----- Responsável interno -----
  /// User da Company que cuida deste operador (gerente do contrato).
  responsibleId   String?
  responsible     User?    @relation("OperatorResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  // ----- Termo de Confidencialidade (decisão 6 — campo simples) -----
  confidentialityTermSignedAt    DateTime?
  /// Path no Vercel Blob (PDF do termo assinado).
  confidentialityTermAttachment  String?

  // ----- Contrato (1 ativo por operador; histórico fica como pendência) -----
  contractLabel        String?
  contractSignedAt     DateTime?
  contractExpiresAt    DateTime?
  contractLastReviewedAt DateTime?
  /// Data do contrato ORIGINAL — relevante quando o contrato é
  /// pré-LGPD e está em adequação via termo aditivo. `contractSignedAt`
  /// pode então virar a data do aditivo. (Checkpoint 14 H1)
  contractOriginalDate DateTime?
  /// "VIGENTE" | "VENCENDO_90D" | "VENCIDO" | "EM_RENOVACAO" |
  /// "SEM_CONTRATO" | "NAO_APLICAVEL"
  /// "VENCENDO_90D" é calculado on-demand a partir de contractExpiresAt.
  contractStatus       String   @default("SEM_CONTRATO")
  /// Status do ciclo de adequação LGPD (Checkpoint 14 H1):
  /// "NAO_AVALIADO" — default, ainda não passou por avaliação
  /// "EM_ADEQUACAO"  — em campanha de adequação (5 ações no Plano)
  /// "ADEQUADO"      — passou por avaliação e tem cláusulas LGPD ok
  /// "NAO_APLICAVEL" — relação não trata dados pessoais (ex: aluguel imóvel)
  lgpdComplianceStatus String   @default("NAO_AVALIADO")

  // ----- Régua de risco do CONTRATO (6 critérios ANPD) -----
  largaEscala          Boolean  @default(false)
  afetaTitulares       Boolean  @default(false)
  novasTecnologias     Boolean  @default(false)
  vigilanciaPublica    Boolean  @default(false)
  decisaoAutomatizada  Boolean  @default(false)
  dadosSensiveis       Boolean  @default(false)
  /// Calculado a partir dos 6 booleanos. Persistido pra filtros/index.
  /// "ALTO" | "MEDIO" | "BAIXO"
  contractRiskClass    String   @default("BAIXO")

  /// Cláusula recomendada (calculada). Templates em G3.
  /// "ROBUSTA" | "SIMPLES" | "CC" | "CLIENTE_OPERADOR" | "MINUTA" |
  /// "INDEFINIDO"
  recommendedClause    String   @default("INDEFINIDO")

  // ----- Cláusulas presentes no contrato atual (checklist do XLSX modelo) -----
  hasPrivacyClause            Boolean  @default(false)
  hasIncidentClause           Boolean  @default(false)
  /// Prazo (em dias) pra notificação de incidente (se contrato exige).
  incidentNotificationDays    Int?
  permitsSubcontracting       Boolean  @default(false)
  permitsInternationalTransfer Boolean @default(false)
  /// Indica se o contrato segue minuta padrão da empresa.
  isStandardMinute            Boolean  @default(false)

  /// Anexos do contrato: PDF principal + DPA + evidências.
  /// Estrutura: [{ name, url, uploadedAt, kind: "CONTRATO" | "DPA" |
  ///              "EVIDENCIA" | "OUTRO" }]
  contractAttachments         Json     @default("[]")

  // ----- Avaliação do terceiro (G2 — Formulário) -----
  assessments OperatorAssessment[]

  // ----- Vínculo com processos do Inventário -----
  processLinks    OperatorProcessLink[]

  // ----- Auditoria -----
  createdById     String
  createdBy       User     @relation("OperatorCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, relationType])
  @@index([companyId, contractRiskClass])
  @@index([companyId, contractStatus])
  @@index([companyId, lgpdComplianceStatus])
  @@map("operators")
}

/// Vínculo M:N entre Operator e DataInventory — cada linha indica que
/// um operador trata dados em um processo específico do Inventário,
/// com descrição opcional da atividade exata.
model OperatorProcessLink {
  id                  String   @id @default(cuid())
  operatorId          String
  operator            Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  dataInventoryId     String
  dataInventory       DataInventory @relation(fields: [dataInventoryId], references: [id], onDelete: Cascade)

  /// Atividade específica que o operador faz nesse processo
  /// (ex: "Hospedagem do banco de dados de clientes").
  activityDescription String?  @db.Text

  createdAt           DateTime @default(now())

  @@unique([operatorId, dataInventoryId])
  @@index([dataInventoryId])
  @@map("operator_process_links")
}

/// Avaliação de Terceiro — formulário de risco preenchido pelo
/// próprio terceiro (link público com token, sem auth) e revisado
/// pelo encarregado.
///
/// Catálogo das 52 perguntas em `lib/operadores-formulario.ts` (7
/// blocos, tags CYBER/LGPD/CYBER_LGPD).
/// Engine de pontuação em `lib/operadores-pontuacao.ts` — calcula
/// scores Cyber e LGPD SEPARADOS, classificando em ALTO/MEDIO/BAIXO
/// com base em % do gabarito.
///
/// Fluxo:
///   1. DPO cria → status=PENDENTE
///   2. DPO "envia pra terceiro" → gera publicToken, status=AGUARDANDO_TERCEIRO
///   3. Terceiro acessa `/avaliacao-terceiro/<token>` (sem auth) e
///      preenche → status segue AGUARDANDO_TERCEIRO até clicar
///      "Finalizar"
///   4. Terceiro finaliza → status=RESPONDIDO + thirdPartyCompletedAt
///   5. DPO revisa, anota, finaliza → status=REVISADO + scores
///      consolidados (cyberScore, lgpdScore, percentages, riskClasses)
model OperatorAssessment {
  id              String   @id @default(cuid())
  operatorId      String
  operator        Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  /// Rótulo opcional (ex: "Avaliação 2026", "Renovação")
  label           String?

  /// "PENDENTE" | "AGUARDANDO_TERCEIRO" | "RESPONDIDO" | "REVISADO" | "CANCELADO"
  status          String   @default("PENDENTE")

  /// Token URL-safe do link público. Único — funciona como "chave"
  /// pra autenticação sem login do terceiro. Revogar = setar null.
  publicToken     String?  @unique

  /// Quando DPO enviou pro terceiro (token gerado).
  sentAt          DateTime?
  /// Quando terceiro abriu o link pela 1ª vez.
  thirdPartyStartedAt   DateTime?
  /// Quando terceiro clicou em "Finalizar".
  thirdPartyCompletedAt DateTime?

  /// Respostas do terceiro:
  ///   { qid: { answer: "S" | "N" | "NA", evidence?: string, comment?: string } }
  /// Tipado por `FormResponses` em `lib/operadores-formulario.ts`.
  thirdPartyAnswers     Json     @default("{}")

  // ----- Revisão pelo DPO -----
  /// Notas do DPO por pergunta:
  ///   { qid: "comentário do DPO" }
  dpoNotes              Json     @default("{}")

  reviewedById          String?
  reviewedBy            User?    @relation("AssessmentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt            DateTime?

  // ----- Pontuação consolidada (calculada ao revisar) -----
  cyberScore            Int      @default(0)
  cyberMax              Int      @default(0)
  cyberPercentage       Float    @default(0)
  cyberRiskClass        String?  // ALTO | MEDIO | BAIXO

  lgpdScore             Int      @default(0)
  lgpdMax               Int      @default(0)
  lgpdPercentage        Float    @default(0)
  lgpdRiskClass         String?

  overallPercentage     Float    @default(0)
  overallRiskClass      String?

  // ----- Auditoria -----
  createdById     String
  createdBy       User     @relation("AssessmentCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([operatorId, status])
  @@map("operator_assessments")
}

model Document {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  title           String
  type            String   // "privacy_policy", "terms_of_use", "cookie_notice", etc.
  content         String   @db.Text
  version         String   @default("1.0")
  status          String   @default("Draft")
  language        String   @default("pt-BR")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("documents")
}

/// Incidente de segurança envolvendo dados pessoais (Checkpoint 16).
///
/// Base legal: Art. 48 LGPD + Resolução CD/ANPD nº 15/2024.
/// Prazo legal: 3 dias úteis (≈72h) pra comunicar ANPD desde a ciência.
///
/// Workflow (status):
///   DETECTADO → EM_ANALISE → EM_CONTENCAO →
///     COMUNICADO_ANPD → COMUNICADO_TITULARES → ENCERRADO
///   (ou FALSO_POSITIVO em qualquer momento)
///
/// Severidade:
///   - "ALTO" / "MEDIO" — disparam obrigatoriedade de comunicação ANPD
///     (Art. 48 §3º LGPD)
///   - "BAIXO" — comunicação discricionária
///
/// Prazo regressivo: 72h desde `detectedAt` até `anpdNotifiedAt` (clock
/// visual no editor + badge sidebar quando <24h).
///
/// Refatorado em 2026-05-05 substituindo o placeholder do template
/// Abacus original (que era um CRUD raso sem workflow nem comunicação).
model Incident {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ----- Identificação -----
  /// Título descritivo curto (ex: "Vazamento de e-mails do CRM")
  title           String
  /// Descrição livre (o que aconteceu, contexto narrativo)
  description     String   @db.Text
  /// "VAZAMENTO" | "ACESSO_NAO_AUTORIZADO" | "PERDA" | "ALTERACAO_INDEVIDA"
  /// | "INDISPONIBILIDADE" | "OUTRO"
  incidentType    String

  // ----- Workflow + severidade -----
  /// "DETECTADO" | "EM_ANALISE" | "EM_CONTENCAO" | "COMUNICADO_ANPD"
  /// | "COMUNICADO_TITULARES" | "ENCERRADO" | "FALSO_POSITIVO"
  status          String   @default("DETECTADO")
  /// "ALTO" | "MEDIO" | "BAIXO"
  severity        String   @default("MEDIO")

  // ----- Datas-chave -----
  /// Quando o incidente ocorreu de fato (estimado; pode ser anterior à detecção)
  occurredAt      DateTime?
  /// Quando a empresa teve ciência. Start do prazo de 72h pra ANPD.
  detectedAt      DateTime
  /// Quando ANPD foi notificada (null = ainda não)
  anpdNotifiedAt  DateTime?
  /// Quando os titulares foram notificados (null = ainda não / não aplicável)
  subjectsNotifiedAt DateTime?
  /// Quando o incidente foi encerrado
  closedAt        DateTime?

  // ----- Dados afetados (texto livre no MVP; M:N com Inventário/Operadores
  // fica pra refino futuro F2/F3) -----
  /// Tipos/categorias de dados pessoais afetados
  affectedDataTypes String? @db.Text
  /// Houve dados sensíveis (Art. 11 LGPD)?
  hasSensitiveData Boolean @default(false)
  /// Categorias de titulares (clientes, funcionários, candidatos, ...)
  affectedSubjectsCategories String? @db.Text
  /// Volume estimado de titulares afetados
  affectedSubjectsCount Int?

  // ----- Técnico -----
  /// Causa raiz identificada
  rootCause       String?  @db.Text
  /// Vetor de origem (Phishing, Erro humano, Falha técnica, Acesso indevido, etc.)
  attackVector    String?
  /// Sistemas/ativos afetados (texto livre)
  affectedSystems String?  @db.Text
  /// Operadores/terceiros envolvidos (texto livre)
  affectedOperators String? @db.Text

  // ----- Risco e medidas (Res. CD/ANPD nº 15/2024) -----
  /// Avaliação de risco aos titulares
  riskAssessment           String? @db.Text
  /// Medidas técnicas e administrativas que estavam em vigor
  securityMeasuresInPlace  String? @db.Text
  /// Medidas de contenção (curto prazo)
  containmentMeasures      String? @db.Text
  /// Medidas corretivas/preventivas (médio/longo prazo)
  correctiveMeasures       String? @db.Text
  /// Justificativa de eventual demora pra comunicar ANPD (Res. 15/2024)
  delayJustification       String? @db.Text

  // ----- Encerramento -----
  /// Notas finais / lições aprendidas
  closureNotes    String?  @db.Text

  // ----- Auditoria -----
  /// Quem registrou (qualquer papel)
  createdById     String?
  createdBy       User?    @relation("IncidentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// Quem encerrou (DPO)
  closedById      String?
  closedBy        User?    @relation("IncidentClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  // ----- Histórico de comunicações -----
  communications  IncidentCommunication[]

  // ----- Plug Plano de Ação (F1) -----
  /// Ações geradas a partir deste incidente (origin = INCIDENTE)
  actionPlans     ActionPlan[] @relation("ActionPlanIncident")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId, severity])
  @@index([companyId, detectedAt])
  @@map("incidents")
}

/// Histórico de comunicações de um incidente — pra ANPD ou titulares.
/// Cada vez que o DPO gera o ofício, criamos uma linha aqui pra
/// auditoria (quem gerou, quando, qual canal, snapshot do conteúdo).
model IncidentCommunication {
  id          String   @id @default(cuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  /// "ANPD" | "TITULARES"
  target      String
  /// Snapshot do conteúdo gerado (markdown ou texto livre)
  content     String   @db.Text
  /// "EMAIL" | "PROTOCOLO_ANPD" | "OFICIO" | "OUTRO" | null
  channel     String?

  /// Quem gerou
  createdById String?
  createdBy   User?    @relation("IncidentCommGeneratedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())

  @@index([incidentId])
  @@map("incident_communications")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model PhaseDocument {
  id              String   @id @default(cuid())
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  phase           String   // "preliminar", "fase-1", "fase-2", etc.
  title           String
  description     String?
  
  // Para arquivos enviados
  fileName        String?
  fileType        String?  // "pdf", "doc", "video", etc.
  fileSize        Int?     // Tamanho em bytes
  mimeType        String?
  cloud_storage_path String? // Caminho do arquivo no S3
  
  // Para vídeos via URL
  videoUrl        String?  // URL do vídeo (YouTube, Vimeo, etc.)
  isVideoUrl      Boolean  @default(false) // Indica se é um vídeo via URL
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("phase_documents")
}

model PhaseInfo {
  id              String   @id @default(cuid())
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  phase           String   // "preliminar", "fase-1", "fase-2", etc.
  section         String   @default("description") // "description", "consideracoes", etc.
  
  // E-book Heyzine (antes da descrição) - SOMENTE ADMIN PODE EDITAR
  heyzineEmbedUrl String?  @db.Text // URL de embed do Heyzine
  
  // Descrição da Fase - SOMENTE ADMIN PODE EDITAR
  description     String?  @db.Text // Conteúdo HTML da descrição da fase
  
  // Checklist de Implementação (depois da descrição) - SOMENTE ADMIN PODE EDITAR  
  howToProceed    String?  @db.Text // Passo-a-passo em formato texto/HTML
  
  // Conteúdo HTML editável do Checklist de implementação - SOMENTE ADMIN PODE EDITAR
  checklistHtml   String?  @db.Text // HTML personalizado para o checklist
  
  // Estado dos checkboxes do checklist (JSON) - USUÁRIOS PODEM SALVAR SEU PROGRESSO
  checklistState  Json?    // { "item-id": true/false }
  
  // URLs "Na prática" - links para aplicativos externos - SOMENTE ADMIN PODE EDITAR
  practicalUrls   Json?    // Array de objetos: [{ title: string, url: string, description?: string, displayMode?: "new-tab" | "embed" }]
  
  // Indica se é um e-book global (criado pelo admin) ou específico da empresa
  isGlobal        Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, phase])
  @@map("phase_infos")
}

model GlobalSettings {
  id String @id @default(cuid())
  
  // URL do e-book do RIPD (compartilhado por todas as empresas)
  ripdEbookUrl String? @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("global_settings")
}

model RipdChecklistProgress {
  id     String @id @default(cuid())
  userId String
  
  // Estado do checklist (JSON com os IDs dos itens marcados)
  completedItems Json @default("[]")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId])
  @@map("ripd_checklist_progress")
}

model SystemSettings {
  id String @id @default(cuid())
  companyId String @unique
  
  // Configurações de Email
  smtpServer String?
  smtpPort String?
  smtpUser String?
  smtpPassword String?
  
  // Notificações
  emailNotifications Boolean @default(true)
  pushNotifications Boolean @default(true)
  deadlineReminders Boolean @default(true)
  incidentAlerts Boolean @default(true)
  
  // Segurança
  twoFactorAuth Boolean @default(false)
  sessionTimeout Boolean @default(true)
  sessionTimeoutMinutes Int @default(30)
  
  // Sistema
  autoBackup Boolean @default(true)
  backupTime String @default("02:00")
  autoDarkMode Boolean @default(false)
  language String @default("pt-BR")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("system_settings")
}

model ContentCategory {
  id          String   @id @default(cuid())
  name        String   // Nome da categoria, ex: "LGPD - Artigos comentados"
  description String?  @db.Text // Descrição da categoria
  imageUrl    String?  // URL da imagem representativa
  order       Int      @default(0) // Ordem de exibição
  
  // Relacionamento com conteúdos
  contentItems ContentItem[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("content_categories")
}

model ContentItem {
  id          String   @id @default(cuid())
  categoryId  String
  category    ContentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  title       String   // Título do conteúdo
  description String?  @db.Text // Descrição do conteúdo
  type        String   // "ebook", "word", "pdf", "excel", "url", "video"
  order       Int      @default(0) // Ordem de exibição
  
  // Para arquivos (word, pdf, excel)
  fileName        String?
  fileSize        Int?     // Tamanho em bytes
  mimeType        String?
  cloud_storage_path String? // Caminho do arquivo no S3
  
  // Para e-books Heyzine e embeds de URL/vídeo
  embedUrl    String?  @db.Text // URL de embed (Heyzine, YouTube, páginas web, etc.)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("content_items")
}

model PhaseEbook {
  id              String   @id @default(cuid())
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  phase           String   // "fase-6", etc.
  title           String   // Título do e-book
  embedUrl        String   @db.Text // URL de embed do Heyzine ou outro
  order           Int      @default(0) // Ordem de exibição
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("phase_ebooks")
  @@index([companyId, phase])
}

// ========== CHATBOT DETETIVE DA PRIVACIDADE ==========

model ChatConversation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title           String?  // Título da conversa (gerado a partir da primeira mensagem)
  lastPageContext String?  // Última página onde o usuário estava
  mode            String   @default("simple") // "simple" ou "technical"
  
  messages        ChatMessage[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("chat_conversations")
  @@index([userId])
}

model ChatMessage {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  role            String   // "user" ou "assistant"
  content         String   @db.Text
  pageContext     String?  // Página onde a mensagem foi enviada (ex: "fase-1", "dashboard")
  
  // Detecção de sentimento (apenas para mensagens do usuário)
  sentiment       String?  // "positive", "neutral", "negative", "frustrated", "confused"
  sentimentScore  Float?   // Score de confiança (0-1)
  
  // Arquivo anexado
  hasAttachment   Boolean  @default(false)
  
  feedback        ChatFeedback?
  
  createdAt DateTime @default(now())
  
  @@map("chat_messages")
  @@index([conversationId])
}

model ChatFeedback {
  id              String   @id @default(cuid())
  messageId       String   @unique
  message         ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  
  rating          String   // "like" ou "dislike"
  comment         String?  @db.Text // Comentário opcional do usuário
  
  createdAt DateTime @default(now())
  
  @@map("chat_feedbacks")
}

// Arquivos anexados ao chat
model ChatFile {
  id              String   @id @default(cuid())
  messageId       String?
  conversationId  String
  
  fileName        String
  fileType        String   // "pdf", "doc", "docx", "txt", "xlsx"
  fileSize        Int      // Tamanho em bytes
  mimeType        String
  cloud_storage_path String // Caminho no S3
  
  // Conteúdo extraído do arquivo (para análise)
  extractedText   String?  @db.Text
  
  createdAt DateTime @default(now())
  
  @@map("chat_files")
  @@index([conversationId])
}

// Sistema de cotas de uso do chatbot
model ChatQuota {
  id              String   @id @default(cuid())
  userId          String   @unique
  
  // Limites diários
  dailyMessages   Int      @default(0)      // Mensagens enviadas hoje
  dailyFiles      Int      @default(0)      // Arquivos enviados hoje
  lastResetDate   DateTime @default(now())  // Data do último reset
  
  // Limites mensais
  monthlyMessages Int      @default(0)      // Mensagens enviadas este mês
  monthlyFiles    Int      @default(0)      // Arquivos enviados este mês
  lastMonthReset  DateTime @default(now())  // Data do último reset mensal
  
  // Configurações de limite (podem ser customizadas por usuário)
  maxDailyMessages   Int   @default(50)     // Limite diário de mensagens
  maxDailyFiles      Int   @default(10)     // Limite diário de arquivos
  maxMonthlyMessages Int   @default(500)    // Limite mensal de mensagens
  maxMonthlyFiles    Int   @default(50)     // Limite mensal de arquivos
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("chat_quotas")
}

// ========== RAG: Knowledge Base Indexing ==========
// Tabela de chunks de documentos com embeddings vetoriais (pgvector).
// O campo "embedding" é gerenciado por SQL bruto pois Prisma não tipa
// vector(N) nativamente.
model DocumentChunk {
  id          String   @id @default(cuid())
  source      String   // path público do arquivo original ("/phase-documents/...")
  sourceTitle String   // título humano ("1 - Cronograma...")
  phase       String?  // "fase-1", "preliminar", etc — null se for global
  chunkIndex  Int      // posição do chunk dentro do documento
  text        String   @db.Text
  // embedding vector(768) — adicionado via migração raw SQL.
  embedding   Unsupported("vector(768)")?

  createdAt DateTime @default(now())

  @@index([phase])
  @@index([source])
  @@map("document_chunks")
}

