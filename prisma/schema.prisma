  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("system_settings")
}

model ContentCategory {
  id          String   @id @default(cuid())
  name        String   // Nome da categoria, ex: "LGPD - Artigos comentados"
  description String?  @db.Text // Descrição da categoria
  imageUrl    String?  // URL da imagem representativa
  order       Int      @default(0) // Ordem de exibição
  
  // Relacionamento com conteúdos
  contentItems ContentItem[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("content_categories")
}

model ContentItem {
  id          String   @id @default(cuid())
  categoryId  String
  category    ContentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  title       String   // Título do conteúdo
  description String?  @db.Text // Descrição do conteúdo
  type        String   // "ebook", "word", "pdf", "excel", "url", "video"
  order       Int      @default(0) // Ordem de exibição
  
  // Para arquivos (word, pdf, excel)
  fileName        String?
  fileSize        Int?     // Tamanho em bytes
  mimeType        String?
  cloud_storage_path String? // Caminho do arquivo no S3
  
