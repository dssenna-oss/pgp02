  updatedAt DateTime @updatedAt
  
  @@map("content_items")
}

model PhaseEbook {
  id              String   @id @default(cuid())
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  phase           String   // "fase-6", etc.
  title           String   // Título do e-book
  embedUrl        String   @db.Text // URL de embed do Heyzine ou outro
  order           Int      @default(0) // Ordem de exibição
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("phase_ebooks")
  @@index([companyId, phase])
}

// ========== CHATBOT DETETIVE DA PRIVACIDADE ==========

model ChatConversation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title           String?  // Título da conversa (gerado a partir da primeira mensagem)
  lastPageContext String?  // Última página onde o usuário estava
  mode            String   @default("simple") // "simple" ou "technical"
  
  messages        ChatMessage[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("chat_conversations")
  @@index([userId])
}

model ChatMessage {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  role            String   // "user" ou "assistant"
  content         String   @db.Text
  pageContext     String?  // Página onde a mensagem foi enviada (ex: "fase-1", "dashboard")
  
  // Detecção de sentimento (apenas para mensagens do usuário)
  sentiment       String?  // "positive", "neutral", "negative", "frustrated", "confused"
  sentimentScore  Float?   // Score de confiança (0-1)
  
  // Arquivo anexado
  hasAttachment   Boolean  @default(false)
  
  feedback        ChatFeedback?
  
  createdAt DateTime @default(now())
  
  @@map("chat_messages")
  @@index([conversationId])
}

model ChatFeedback {
  id              String   @id @default(cuid())
  messageId       String   @unique
  message         ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  
  rating          String   // "like" ou "dislike"
  comment         String?  @db.Text // Comentário opcional do usuário
  
  createdAt DateTime @default(now())
  
  @@map("chat_feedbacks")
}

// Arquivos anexados ao chat
model ChatFile {
  id              String   @id @default(cuid())
  messageId       String?
  conversationId  String
  
  fileName        String
  fileType        String   // "pdf", "doc", "docx", "txt", "xlsx"
  fileSize        Int      // Tamanho em bytes
  mimeType        String
  cloud_storage_path String // Caminho no S3
  
  // Conteúdo extraído do arquivo (para análise)
  extractedText   String?  @db.Text
  
  createdAt DateTime @default(now())
  
  @@map("chat_files")
  @@index([conversationId])
}

// Sistema de cotas de uso do chatbot
model ChatQuota {
  id              String   @id @default(cuid())
  userId          String   @unique
  
  // Limites diários
  dailyMessages   Int      @default(0)      // Mensagens enviadas hoje
  dailyFiles      Int      @default(0)      // Arquivos enviados hoje
  lastResetDate   DateTime @default(now())  // Data do último reset
  
  // Limites mensais
  monthlyMessages Int      @default(0)      // Mensagens enviadas este mês
  monthlyFiles    Int      @default(0)      // Arquivos enviados este mês
  lastMonthReset  DateTime @default(now())  // Data do último reset mensal
  
  // Configurações de limite (podem ser customizadas por usuário)
  maxDailyMessages   Int   @default(50)     // Limite diário de mensagens
  maxDailyFiles      Int   @default(10)     // Limite diário de arquivos
  maxMonthlyMessages Int   @default(500)    // Limite mensal de mensagens
  maxMonthlyFiles    Int   @default(50)     // Limite mensal de arquivos
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("chat_quotas")
}

// ========== RAG: Knowledge Base Indexing ==========
// Tabela de chunks de documentos com embeddings vetoriais (pgvector).
// O campo "embedding" é gerenciado por SQL bruto pois Prisma não tipa
// vector(N) nativamente.
model DocumentChunk {
  id          String   @id @default(cuid())
  source      String   // path público do arquivo original ("/phase-documents/...")
  sourceTitle String   // título humano ("1 - Cronograma...")
  phase       String?  // "fase-1", "preliminar", etc — null se for global
  chunkIndex  Int      // posição do chunk dentro do documento
  text        String   @db.Text
  // embedding vector(768) — adicionado via migração raw SQL.
  embedding   Unsupported("vector(768)")?

  createdAt DateTime @default(now())

  @@index([phase])
  @@index([source])
  @@map("document_chunks")
}

