# =====================================================================
# Variáveis de ambiente de PRODUÇÃO (Vercel)
# =====================================================================
# Copie estes valores no painel da Vercel:
#   Settings → Environment Variables → Production
#
# NÃO commite o .env.production real — apenas este .example.
# =====================================================================

# --- Banco de dados (Postgres na nuvem) ---
# Use Vercel Postgres, Neon, Supabase ou Railway.
# Exemplo do Neon: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/pgp_database?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/pgp_database?sslmode=require

# --- NextAuth (autenticação) ---
# Gere um valor único pra produção: openssl rand -base64 32
NEXTAUTH_SECRET=GERE-UMA-CHAVE-DIFERENTE-DA-DE-DEV
# Atualize pro domínio final assim que apontar (sem trailing slash):
NEXTAUTH_URL=https://seudominio.com.br

# --- Abacus AI (chatbot Detetive da Privacidade) ---
ABACUSAI_API_KEY=sua-chave-da-abacus

# --- AWS S3 (uploads de logo/documentos) ---
AWS_BUCKET_NAME=seu-bucket
AWS_REGION=us-east-1
AWS_FOLDER_PREFIX=pgp/
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_SESSION_TOKEN=  # opcional, só se usar credenciais temporárias (STS)
