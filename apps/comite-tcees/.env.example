# ============================================================================
# Variáveis de ambiente — app do Comitê LGPD (TCEES)
# Copie para .env e preencha. O .env NÃO vai para o git.
# ============================================================================

# Banco de dados (Neon Postgres). Hospedagem "decidir depois" — por ora Neon.
# Crie um projeto/branch novo no Neon SÓ para este app (não reusar o do curso).
DATABASE_URL="postgresql://USUARIO:SENHA@HOST/comite?sslmode=require"
# URL direta (sem pooler) — usada pelo prisma db push / migrate / seed.
DIRECT_URL="postgresql://USUARIO:SENHA@HOST/comite?sslmode=require"

# Segredo do NextAuth — gere com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-segredo-aleatorio"
NEXTAUTH_URL="http://localhost:3200"
