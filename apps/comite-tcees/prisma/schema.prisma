// =============================================================================
// Comitê LGPD — TCEES (mono-instituição)
// Schema do módulo "Comitê & Plano de Trabalho" + autenticação simples.
// Sem multi-tenant / papéis de curso. Outra instituição = nova cópia do app.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// AUTENTICAÇÃO
// -----------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String // bcrypt hash
  role      String   @default("MEMBRO") // ADMIN | COORDENADOR | MEMBRO
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

// -----------------------------------------------------------------------------
// IDENTIDADE DO COMITÊ (linha única de configuração da instituição)
// -----------------------------------------------------------------------------

model Comite {
  id            String  @id @default(cuid())
  instituicao   String // "Tribunal de Contas do Estado do Espírito Santo — TCEES"
  sigla         String // "TCEES"
  nomeComite    String // "Comitê Executivo de Proteção de Dados Pessoais"
  bienio        String // "2026-2027"
  cnpj          String?
  sede          String?
  portal        String?
  canalEncarregado String?
  vinculoSegov  String? // texto do vínculo institucional
  marcoMae      String? // descrição do marco-mãe
  marcoMaePrazo DateTime?
  updatedAt     DateTime @updatedAt

  @@map("comite")
}

// -----------------------------------------------------------------------------
// EIXOS DO CRONOGRAMA (A–E) — tabela de apoio
// -----------------------------------------------------------------------------

model Eixo {
  id        String  @id @default(cuid())
  codigo    String  @unique // "A" | "B" | "C" | "D" | "E"
  nome      String // "Governança / Homologação"
  descricao String?
  ordem     Int     @default(0)

  @@map("eixos")
}

// -----------------------------------------------------------------------------
// MEMBROS DO COMITÊ
// -----------------------------------------------------------------------------

model Membro {
  id        String  @id @default(cuid())
  nome      String
  funcao    String // "Presidente" | "Coordenador" | "Encarregado titular" | "Encarregado substituto" | "Membro"
  cargo     String? // "Conselheiro do TCEES"
  unidade   String? // "SEGAFI" | "SEGEX" ...
  matricula String?
  inciso    String? // "I, a" — referência à Portaria
  email     String? // contato oficial / externo (a página pública do DPO usa este)
  emailInterno String? // e-mail p/ comunicações internas do Comitê (sobrepõe o email nos avisos)
  ordem     Int     @default(0)
  createdAt DateTime @default(now())

  @@map("membros")
}

// -----------------------------------------------------------------------------
// ENTREGAS DO PLANO DE TRABALHO (cronograma 8 trimestres × 5 eixos)
// -----------------------------------------------------------------------------

model Entrega {
  id            String    @id @default(cuid())
  titulo        String
  descricao     String?
  eixoCodigo    String // "A".."E"
  trimestre     String // "Q2-2026" .. "Q4-2027"
  responsavel   String?
  prazoTexto    String? // "30/06/2026" ou "Q3/2026"
  prazoData     DateTime? // quando há data exata (alimenta o calendário)
  status        String    @default("A_INICIAR") // CONCLUIDO | EM_ANDAMENTO | A_INICIAR | ATRASADO
  ferramentaHref String? // link para o módulo que executa a entrega (Etapa 3)
  ordem         Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([eixoCodigo])
  @@index([trimestre])
  @@map("entregas")
}

// -----------------------------------------------------------------------------
// MARCOS CRÍTICOS DO BIÊNIO
// -----------------------------------------------------------------------------

model Marco {
  id          String   @id @default(cuid())
  data        DateTime
  descricao   String
  eixoCodigos String // "A" ou "A,B,C,D,E" (marco-mãe)
  tipo        String   @default("NORMAL") // NORMAL | MAE
  status      String   @default("A_INICIAR") // CONCLUIDO | EM_ANDAMENTO | A_INICIAR | CRITICO
  ordem       Int      @default(0)

  @@map("marcos")
}

// -----------------------------------------------------------------------------
// REUNIÕES & ATAS
// -----------------------------------------------------------------------------

model Reuniao {
  id            String   @id @default(cuid())
  titulo        String
  data          DateTime
  hora          String?
  local         String?
  pauta         String?
  decisoes      String? // texto livre das decisões
  presentes     Int? // participantes presentes
  totalConvocados Int?
  status        String   @default("AGENDADA") // AGENDADA | REALIZADA
  pautaAprovada Boolean  @default(false) // marcador: pauta aprovada pelo colegiado?
  ataRegistrada Boolean  @default(false) // marcador: ata foi registrada?
  ataUrl        String? // link opcional para o documento da ata
  ordem         Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("reunioes")
}

// -----------------------------------------------------------------------------
// CONSULTA PRÉVIA AO COMITÊ
// -----------------------------------------------------------------------------

model ConsultaPrevia {
  id          String    @id @default(cuid())
  titulo      String
  area        String?
  descricao   String?
  parecerCju  String? // "favorável" | texto
  status      String    @default("EM_ANALISE") // RESPONDIDA | EM_ANALISE | PENDENCIA
  abertaEm    DateTime?
  respondidaEm DateTime?
  ordem       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@map("consultas_previas")
}

// -----------------------------------------------------------------------------
// DOCUMENTOS DO COMITÊ
// -----------------------------------------------------------------------------

model Documento {
  id           String    @id @default(cuid())
  nome         String
  tipo         String? // "Instrumento mater" | "Política" | "Norma interna" | "Ata de reunião" ...
  versao       String?
  status       String    @default("A_ELABORAR") // A_ELABORAR | ELABORADO | PENDENTE_APROVACAO | HOMOLOGADO | REGISTRADA
  atualizadoEm String? // texto livre ("25/06/2024", "2024", "—")
  arquivoUrl   String?
  ordem        Int       @default(0)
  createdAt    DateTime  @default(now())

  @@map("documentos")
}

// -----------------------------------------------------------------------------
// INDICADORES DE MONITORAMENTO (Seção 9 do Plano)
// -----------------------------------------------------------------------------

model Indicador {
  id         String  @id @default(cuid())
  codigo     String  @unique // "A1".."E10", "I1".."I5"
  eixoCodigo String // "A".."E" ou "IMPACTO"
  descricao  String
  tipo       String // "Estrutural" | "Processual" | "Resultado" | "Impacto"
  unidade    String?
  meta2026   String?
  meta2027   String?
  valorAtual String? // "0/3", "—", "12/115" ...
  status     String  @default("A_INICIAR") // CONCLUIDO | EM_ANDAMENTO | EM_RISCO | ATRASADO | A_INICIAR
  ordem      Int     @default(0)

  @@index([eixoCodigo])
  @@map("indicadores")
}

// -----------------------------------------------------------------------------
// FASE 3 — INVENTÁRIO DE DADOS PESSOAIS (mono-instituição; adaptado do lgpd-curso)
// -----------------------------------------------------------------------------

model DataInventory {
  id               String   @id @default(cuid())
  nome             String // nome do processo/serviço/sistema
  unidadeGestora   String? // SGTI, SEGAFI, SEGEX...
  hipoteseMacro    String? // "I" | "II" | "III" | "IV" (Seção 7.3 do Plano)
  finalidade       String?
  baseLegal        String?
  tiposDados       String? // texto livre / JSON
  dadosSensiveis   Boolean  @default(false)
  retencao         String?
  compartilhamento String?
  medidasSeguranca String?
  prioritario      Boolean  @default(false) // um dos 12 processos prioritários
  status           String   @default("PRELIMINAR") // PRELIMINAR | EM_REVISAO | CONCLUIDO
  observacoes      String?
  ordem            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  riscos ProcessRisk[]
  ripds  Ripd[]

  @@map("data_inventories")
}

// Fase 3 — Análise de Riscos (matriz Probabilidade × Impacto por processo)
model ProcessRisk {
  id            String        @id @default(cuid())
  inventoryId   String
  inventory     DataInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  descricao     String // ameaça / risco identificado
  probabilidade Int           @default(2) // 1=Baixa, 2=Média, 3=Alta
  impacto       Int           @default(2) // 1=Baixo, 2=Médio, 3=Alto
  recomendacao  String?
  status        String        @default("ABERTO") // ABERTO | TRATADO | ACEITO
  ordem         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([inventoryId])
  @@map("process_risks")
}

// -----------------------------------------------------------------------------
// FASE 6 — EXECUÇÃO · Central de Instrumentos (documentos da jornada LGPD)
// -----------------------------------------------------------------------------

model Instrumento {
  id          String    @id @default(cuid())
  nome        String
  grupo       String // PUBLICO | INTERNO | OPERADORES_TITULAR
  tipo        String? // Política | Aviso | RIPD | Cláusula | Procedimento | Termo...
  baseLegal   String?
  obrigatorio Boolean   @default(false) // obrigatório vs recomendado/condicional
  status      String    @default("A_ELABORAR") // A_ELABORAR | EM_ELABORACAO | PENDENTE_APROVACAO | APROVADO | PUBLICADO
  responsavel String?
  prazo       DateTime?
  conteudoUrl String? // link / anexo do documento
  descricao   String?
  ordem       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([grupo])
  @@map("instrumentos")
}

// -----------------------------------------------------------------------------
// FASE 6 — EDITOR DE POLÍTICAS (markdown + versões + URL pública)
// Mono-instituição: sem companyId. Conteúdo dos instrumentos tipo documento.
// -----------------------------------------------------------------------------

model Policy {
  id    String @id @default(cuid())
  // Tipo do template inicial / tela pública. Ex.: AVISO_PRIVACIDADE_EXTERNO,
  // POLITICA_COOKIES, POLITICA_RETENCAO, NORMA_PRIVACIDADE, OUTRA...
  type  String
  title String
  slug  String @unique // usado na URL pública /p/<slug>

  status String @default("RASCUNHO") // RASCUNHO | PUBLICADA | ARQUIVADA

  currentContent   String  @db.Text // rascunho em markdown (sempre editável)
  publishedContent String? @db.Text // snapshot publicado (vai pra URL pública)
  currentVersion   Int     @default(0)

  publishedAt   DateTime?
  publishedBy   String? // nome/e-mail de quem publicou (sem FK)
  // vínculo opcional ao item da Central de Instrumentos que esta política realiza
  instrumentoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions PolicyVersion[]

  @@index([type])
  @@index([status])
  @@map("policies")
}

model PolicyVersion {
  id       String @id @default(cuid())
  policyId String
  policy   Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  version     Int
  content     String  @db.Text // markdown congelado
  changeLog   String?
  publishedAt DateTime @default(now())
  publishedBy String?

  @@unique([policyId, version])
  @@index([policyId, publishedAt])
  @@map("policy_versions")
}

// -----------------------------------------------------------------------------
// FASE 6 — RIPD (Relatório de Impacto à Proteção de Dados — Res. CD/ANPD 2/2022)
// 8 seções em JSON; pré-popula de Inventário + Riscos. Mono: sem companyId.
// -----------------------------------------------------------------------------

model Ripd {
  id          String         @id @default(cuid())
  inventoryId String? // processo do Inventário origem (RIPDs avulsos permitidos)
  inventory   DataInventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  title  String
  status String @default("RASCUNHO") // RASCUNHO | EM_REVISAO | APROVADO | ARQUIVADO

  data          Json // conteúdo das 8 seções (RipdData em lib/ripd-helpers.ts)
  rejectionNote String? @db.Text

  approvedBy String? // nome/e-mail de quem aprovou (sem FK)
  approvedAt DateTime?

  // versionamento (snapshot a cada aprovação)
  publishedContent    Json?
  publishedAt         DateTime?
  publishedVersionNum Int?
  versions            RipdVersion[]

  instrumentoId String? // vínculo opcional ao item da Central
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([inventoryId])
  @@map("ripds")
}

model RipdVersion {
  id     String @id @default(cuid())
  ripdId String
  ripd   Ripd   @relation(fields: [ripdId], references: [id], onDelete: Cascade)

  version    Int
  content    Json
  changeLog  String?  @db.Text
  approvedAt DateTime @default(now())
  approvedBy String?

  @@unique([ripdId, version])
  @@index([ripdId, approvedAt])
  @@map("ripd_versions")
}

// -----------------------------------------------------------------------------
// FASE 6 — DSR (Direitos do Titular) · PAINEL INTERNO do Encarregado
// Intake é externo (rito oficial: Ouvidoria → Acesso Identificado/NCD →
// e-tcees). Aqui o Encarregado REGISTRA o pedido recebido pra controlar o
// prazo de 15 dias, status e gerar o DOCX de resposta.
// -----------------------------------------------------------------------------

model DataSubjectRequest {
  id             String   @id @default(cuid())
  protocolNumber String // protocolo do rito oficial (e-tcees/Ouvidoria), digitado
  origin         String   @default("ouvidoria") // ouvidoria | acesso_identificado | ncd | outro

  titularName     String
  titularCategory String   @default("cidadao")
  requestedRights String[] // códigos art. 18: ["I","II",...]
  detailedRequest String?  @db.Text

  receivedAt DateTime // início da contagem das 15 dias
  dueDate    DateTime // receivedAt + 15 dias

  status String @default("RECEBIDA") // RECEBIDA | EM_ANALISE | AGUARDANDO_TITULAR | RESPONDIDA | INDEFERIDA

  decision        String? // DEFERIDO | DEFERIDO_PARCIAL | INDEFERIDO
  responseText    String?  @db.Text
  responseActions String?  @db.Text
  responseDate    DateTime?
  respondedBy     String? // nome/e-mail (sem FK)

  instrumentoId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("data_subject_requests")
}

// -----------------------------------------------------------------------------
// FASE 7 — Autoavaliação TCU (iadLGPD, Acórdão 1.384/2022). Guarda só as
// respostas que o Comitê definiu manualmente; o resto é auto/ao vivo.
// -----------------------------------------------------------------------------

model TcuAnswer {
  id           String   @id @default(cuid())
  questionCode String   @unique // "2.1".."10.5" (42 questões do indicador)
  resposta     String // SIM | PARCIAL | NAO | NA
  observacao   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("tcu_answers")
}

// Checklist operacional de monitoramento (Fase 7) — presença = item concluído.
model MonitoringCheck {
  id        String   @id @default(cuid())
  itemId    String   @unique
  createdAt DateTime @default(now())

  @@map("monitoring_checks")
}

// -----------------------------------------------------------------------------
// FASE 7 — Auditoria Interna do PGP (agenda + achados + plano de ação)
// -----------------------------------------------------------------------------

model Auditoria {
  id            String    @id @default(cuid())
  titulo        String
  escopo        String?
  responsavel   String?
  dataPrevista  DateTime?
  dataRealizada DateTime?
  status        String    @default("PLANEJADA") // PLANEJADA | EM_ANDAMENTO | CONCLUIDA
  observacoes   String?   @db.Text
  ordem         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  achados AuditoriaAchado[]

  @@index([status])
  @@map("auditorias")
}

model AuditoriaAchado {
  id          String    @id @default(cuid())
  auditoriaId String
  auditoria   Auditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)

  descricao       String   @db.Text
  severidade      String   @default("MEDIA") // BAIXA | MEDIA | ALTA
  naoConformidade Boolean  @default(true)
  recomendacao    String?  @db.Text
  planoAcao       String?  @db.Text
  prazo           DateTime?
  status          String   @default("ABERTO") // ABERTO | EM_TRATAMENTO | RESOLVIDO
  ordem           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([auditoriaId])
  @@map("auditoria_achados")
}

// -----------------------------------------------------------------------------
// FASE 5 — PLANO DE AÇÃO E ADEQUAÇÃO
// -----------------------------------------------------------------------------

model ActionPlan {
  id          String    @id @default(cuid())
  origem      String    @default("MANUAL") // GAP | RISCO | PLANO | MANUAL
  origemRef   String? // controlCode do GAP, id do risco, etc. (dedup)
  acao        String
  descricao   String?
  responsavel String?
  prazo       DateTime?
  prioridade  String    @default("MEDIA") // BAIXA | MEDIA | ALTA
  status      String    @default("A_FAZER") // A_FAZER | EM_ANDAMENTO | CONCLUIDA
  ordem       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([origem, origemRef])
  @@map("action_plans")
}

// -----------------------------------------------------------------------------
// FASE 4 — GAP ANALYSIS (catálogo de 119 controles vive em lib/gap-catalog.ts)
// -----------------------------------------------------------------------------

model GapAnswer {
  id            String   @id @default(cuid())
  controlCode   String   @unique // "001".."119" (ref. ao GAP_CONTROLS)
  cenarioAtual  String? // situação atual descrita
  mapeamento    String? // NAO_INICIADO | EM_ANDAMENTO | FINALIZADO
  aderencia     String? // ADERENTE | PARCIAL | NAO_ADERENTE | NA
  pontoMelhoria String? // o que precisa melhorar
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("gap_answers")
}

// -----------------------------------------------------------------------------
// FASE 7 — MONITORAMENTO · Incidentes de Segurança (72h ANPD — Res. 15/2024)
// -----------------------------------------------------------------------------

model Incident {
  id                String    @id @default(cuid())
  titulo            String
  descricao         String?
  severidade        String    @default("MEDIA") // BAIXA | MEDIA | ALTA | CRITICA
  status            String    @default("EM_ANALISE") // RASCUNHO | EM_ANALISE | ENCERRADO
  ocorridoEm        DateTime?
  detectadoEm       DateTime? // marca o início da contagem das 72h p/ ANPD
  comunicadoAnpd    Boolean   @default(false)
  comunicadoTitular Boolean   @default(false)
  naturezaDados     String? // que dados foram afetados
  medidasMitigacao  String? // o que foi feito
  ordem             Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("incidents")
}

// -----------------------------------------------------------------------------
// NOTIFICAÇÕES
// -----------------------------------------------------------------------------

model Notificacao {
  id        String   @id @default(cuid())
  tipo      String // "ATRASO" | "DOCUMENTO" | "REUNIAO" | "PRAZO" | "CONSULTA" | "MARCO"
  titulo    String
  descricao String?
  eixoCodigo String?
  href      String?
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notificacoes")
}
