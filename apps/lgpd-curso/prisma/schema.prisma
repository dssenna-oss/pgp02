// =============================================================================
// PGP Treinamento — schema enxuto do curso presencial LGPD (Modalidade A)
// =============================================================================
// Reduz o schema do app de produção mantendo SOMENTE os 8 mini-apps do curso:
//   Inventário · Riscos · GAP · RIPD · Terceiros · DSR · Aviso · Incidentes
// + tabelas específicas do curso (CursoTurma, CursoGrupo).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// MULTI-TENANT BASE
// -----------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String // ex: "Prefeitura Municipal de Vegas — Grupo 1"
  cnpj      String?
  orgao     String? // "PM" ou "CM"
  cidade    String?  @default("Vegas")
  // Encarregado (DPO) — identidade cadastrada uma vez, reutilizada no RIPD,
  // Aviso de Privacidade, Comunicação ANPD, etc. Reduz retrabalho do DPO.
  dpoName              String?
  dpoEmail             String?
  dpoTelefone          String?
  dpoEndereco          String? // endereço comercial pra constar nos documentos legais
  // Encarregado Substituto — figura prevista no Art. 41 §1º como prática
  // recomendada pra continuidade em férias/afastamento.
  dpoSubstitutoNome     String?
  dpoSubstitutoEmail    String?
  dpoSubstitutoTelefone String?
  // Justificativa da escolha do Encarregado — campo opcional preenchido pelo
  // grupo na Fase 1 (Designação do Encarregado). Aparece no Ato de Nomeação
  // DOCX gerado. Auto-migração em lib/coluna-dpo-justificativa.ts.
  dpoJustificativaEscolha String?
  // === Práticas da FASE 2 (Diagnóstico Inicial) ===
  // Lista de setores que tratam dados — grupo discute os setores
  // pré-cadastrados do seu órgão e anota observações. JSON:
  // { setores: [{id, discutido, observacao}], atualizadoEm }.
  // Auto-migração em lib/coluna-fase-2.ts.
  setoresDiscutidos       Json?
  // Matriz de Priorização dos 2 processos — grupo aplica critérios da
  // Res. CD/ANPD nº 2/2022 a cada processo e gera ranking. JSON:
  // { processos: [{processoId, criterios:{...}, score, justificativa}], atualizadoEm }.
  priorizacaoProcessos    Json?
  // === Práticas da FASE PRELIMINAR (Sensibilização e Engajamento) ===
  // Termômetro Institucional aplicado pelo grupo no INÍCIO do curso (auto-
  // diagnóstico de maturidade percebida em 5 dimensões) e repetido no FIM
  // pra evidenciar a evolução. JSON: { dimensoes:[...], score, finalizadoEm }.
  // Estrutura em lib/termometro-perguntas.ts. Auto-migração em
  // lib/coluna-fase-preliminar.ts.
  termometroInicio Json?
  termometroFim    Json?
  // Carta para a Alta Gestão — documento institucional que o grupo personaliza
  // (5 campos com templates auto-preenchidos) e gera DOCX pra impressão.
  // JSON: { destinatario, justificativa, riscosNaoFazer, pedido, assinatura,
  // finalizadaEm, atualizadoEm }.
  cartaAltaGestao  Json?
  // === Quiz "Caça às Pegadinhas" (Encerramento) ===
  // Respostas do grupo ao quiz de detecção das 8 pegadinhas plantadas:
  // 2 nos processos do próprio órgão (PM ou CM) + 6 erros plantados no Aviso.
  // Estrutura: { respostas: [{ pegadinhaId, tipo, detectou, observacao }], score,
  // finalizadoEm }. Auto-migração em lib/coluna-olho-clinico.ts.
  olhoClinicoQuiz  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  inventories DataInventory[]
  risks       ProcessRisk[]
  gapAnswers  GapAnswer[]
  actions     ActionPlan[]
  policies    Policy[]
  incidents   Incident[]
  ripds       Ripd[]
  operators   Operator[]
  dsrRequests DsrRequest[]
  cursoGrupo  CursoGrupo?
  priMembros  PriMembroEquipe[]
  priRaci     PriRaci[]

  @@map("companies")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String // bcrypt hash
  role      String   @default("MEMBER") // ADMIN | DPO | MEMBER
  papel     String? // descritivo do papel no jogo: DPO | SAUDE | RH | TI | COMUNICACAO ...
  isActive  Boolean  @default(true)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // Atualizado pelo heartbeat do client (POST /api/curso/heartbeat a cada 30s)
  // — usado pelo Painel do Facilitador pra mostrar "papéis ativos" em
  // real-time por grupo. Nullable porque users antigos não tinham essa coluna.
  lastSeenAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([email])
  @@map("users")
}

// -----------------------------------------------------------------------------
// CURSO — turmas + grupos
// -----------------------------------------------------------------------------

model CursoTurma {
  id           String    @id @default(cuid())
  nome         String    @unique // ex: "Outubro-2026"
  // Slug sluggificado do nome — entra no email dos participantes:
  // `{papel}.g{N}.{slug}@curso.lgpd`. Garante ISOLAMENTO TOTAL entre turmas:
  // não há como ação numa turma afetar outra, mesmo via SQL direto.
  // Default empty pra retro-compat — backfill via /api/curso/migrar-slug-turmas.
  slug         String    @default("")
  cidade       String    @default("Vegas") // padrão Vegas, editável
  dataPrevista DateTime?
  status       String    @default("ATIVA") // ATIVA | ENCERRADA
  // Marca visual: a turma marcada com "proximoCurso" tem ícone 🎯 no admin.
  // Não bloqueia nada — apenas ajuda o facilitador identificar de relance
  // qual turma vai ser rodada a seguir. Apenas 1 turma pode ter true por vez.
  proximoCurso Boolean   @default(false)
  observacao   String?
  // Senha em texto pra o facilitador relembrar/divulgar aos participantes.
  // Curso fictício, senha compartilhada de propósito — não é segredo.
  // Backfill automático via lib/coluna-senha-turma.ts.
  senhaExibicao String?
  // Pacote customizado de controles GAP — array de IDs do catálogo
  // (lib/gap-catalogo.ts). Vazio = usa PACOTE_DEFAULT. Permite ao facilitador
  // adaptar o GAP ao perfil do grupo (técnicos / jurídicos / gestão).
  gapPacote    Int[]     @default([])
  // Janela de acesso ao app pelos participantes — período "extra" de revisão
  // dos conteúdos (da data inicial do curso até a data limite). Fora dela o
  // login do participante é bloqueado; o facilitador (ADMIN) entra sempre.
  // Null = sem restrição. Backfill automático via lib/colunas-controle-turma.ts.
  acessoInicio  DateTime?
  acessoFim     DateTime?
  // Lista de e-mails reais dos inscritos pra o convite de confirmação de
  // presença. JSON: [{ email, confirmado, confirmadoEm }]. Null = lista vazia.
  participantes Json?
  // Duração do quiz em minutos. Null = sem limite (comportamento anterior).
  // Quando definido, /api/quiz/start retorna `deadline = startedAt + N min`
  // pro cliente, que ao bater na hora bloqueia próximas perguntas e submete
  // automático o que foi respondido. Configurado no /facilitador/quiz.
  // Backfill automático via lib/coluna-quiz-duracao.ts.
  quizDuracaoMinutos Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  grupos CursoGrupo[]
  quizResponses QuizResponse[]

  @@map("curso_turmas")
}

model QuizResponse {
  id                String   @id @default(cuid())
  turmaId           String
  // UUID gerado no localStorage do cliente — permite resgatar resultado sem login.
  // O index único (turmaId, uuid) impede que o mesmo dispositivo conte 2 vezes.
  uuid              String
  startedAt         DateTime @default(now())
  finishedAt        DateTime?
  // Snapshot das respostas: [{ qid, selected, correct, categoria }]. JSON pra
  // evitar tabela auxiliar — o quiz é estático (30 perguntas em lib/), análise
  // agregada é simples sobre o JSON.
  respostas         Json     @default("[]")
  scoreTotal        Int      @default(0)
  // { principios: { correct, total }, bases_legais: {...}, ... } pra mostrar
  // lacunas por categoria ao participante e agregar no painel do facilitador.
  scorePorCategoria Json     @default("{}")

  turma CursoTurma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([turmaId, uuid])
  @@index([turmaId, finishedAt])
  @@map("quiz_responses")
}

model CursoGrupo {
  id        String     @id @default(cuid())
  turmaId   String
  turma     CursoTurma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  numero    Int // 1, 2, 3, 4, 5
  orgao     String // "PM" ou "CM"
  companyId String     @unique
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  assistanceRequests AssistanceRequest[]
  phaseSkipAttempts  PhaseSkipAttempt[]

  @@unique([turmaId, numero])
  @@map("curso_grupos")
}

// Tentativa de pular fase — DPO clicou num botão de ação das Fases 5/6/7
// sem ter concluído a Fase 4 (GAP). Pedagógico: faz o facilitador ser
// alertado pra reafirmar a sequência correta das fases do PGP.
//   PENDING       → tentativa registrada agora
//   ACKNOWLEDGED  → facilitador clicou "Reconhecer" (vai conversar com o grupo)
model PhaseSkipAttempt {
  id              String     @id @default(cuid())
  grupoId         String
  grupo           CursoGrupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  requestedById   String?
  requestedByName String?
  faseTentada     String // "FASE_5" | "FASE_6" | "FASE_7"
  acaoTentada     String? // ex: "Criar Plano de Acao", "Salvar RIPD"
  status          String     @default("PENDING") // PENDING | ACKNOWLEDGED
  createdAt       DateTime   @default(now())
  acknowledgedAt  DateTime?

  @@index([grupoId, status])
  @@map("phase_skip_attempts")
}

// SOS — pedido de presença do facilitador feito por um participante.
// Visualizado em tempo real no Painel do Facilitador (polling 3s).
//   PENDING  → grupo acabou de chamar
//   ATTENDED → facilitador clicou "Atendendo" (já tá indo)
//   RESOLVED → facilitador encerrou
model AssistanceRequest {
  id            String     @id @default(cuid())
  grupoId       String
  grupo         CursoGrupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  requestedById String? // user que clicou (informativo)
  requestedByName String? // congelado pra histórico mesmo se reset da turma
  status        String     @default("PENDING") // PENDING | ATTENDED | RESOLVED
  createdAt     DateTime   @default(now())
  attendedAt    DateTime?
  resolvedAt    DateTime?

  @@index([grupoId, status])
  @@map("assistance_requests")
}

// -----------------------------------------------------------------------------
// MINI-APP 1 — INVENTÁRIO
// -----------------------------------------------------------------------------

model DataInventory {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nome             String // nome do processo/serviço
  setor            String?
  finalidade       String?
  baseLegal        String?
  tiposDados       String? // JSON serializado
  dadosSensiveis   Boolean? @default(false)
  retencao         String?
  compartilhamento String?
  medidasSeguranca String?
  status           String   @default("RASCUNHO") // RASCUNHO | SUBMETIDO | APROVADO | DEVOLVIDO
  formAnswers      Json? // resposta livre (mesma do app de prod)
  feedbackDpo      String? // motivo da devolução pelo DPO (quando status=DEVOLVIDO)
  createdById      String?
  reviewedById     String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  riscos        ProcessRisk[]
  incidentLinks IncidentInventoryLink[]

  @@index([companyId])
  @@map("data_inventories")
}

// -----------------------------------------------------------------------------
// MINI-APP 2 — ANÁLISE DE RISCOS
// -----------------------------------------------------------------------------

model ProcessRisk {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryId    String?
  inventory      DataInventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  riscoTitulo    String
  descricao      String?
  categoria      String?
  severityLevel  String? // P:B|M|A;I:B|M|A;S:BAIXO|MEDIO|ALTO
  mitigationPlan String?
  // Workflow Contribuidor→DPO (Art. 41 §2º LGPD — encarregado aprova análise)
  //   RASCUNHO  → Contribuidor preenchendo
  //   SUBMETIDO → Contribuidor enviou pro DPO (em lote por processo)
  //   APROVADO  → DPO aprovou
  //   DEVOLVIDO → DPO devolveu com feedbackDpo
  status         String         @default("RASCUNHO")
  feedbackDpo    String?
  createdById    String?
  reviewedById   String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  // Tramitação multi-setor: DPO pode pedir apoio a TI/PROCURADORIA/COMUNICACAO
  // antes de aprovar. Quando tramitadoPara != null, o setor de apoio tem
  // acesso de leitura/escrita só nesses riscos.
  tramitadoPara  String?
  tramitacaoNota String?
  tramitadoEm    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  assessments RiskAssessment[]

  @@index([companyId])
  @@map("process_risks")
}

model RiskAssessment {
  id            String      @id @default(cuid())
  riskId        String
  risk          ProcessRisk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  probabilidade String // BAIXA | MEDIA | ALTA
  impacto       String // BAIXO | MEDIO | ALTO
  observacao    String?
  createdAt     DateTime    @default(now())

  @@map("risk_assessments")
}

// -----------------------------------------------------------------------------
// MINI-APP 3 — GAP ANALYSIS (10 controles curados do pacote)
// -----------------------------------------------------------------------------

model GapAnswer {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  controleId    Int // ID estável do gap-catalogo (1-30)
  controleTexto String // congelado no momento da resposta
  area          String // categoria do controle (granular)
  // ADERENTE | PARCIAL | NAO_ADERENTE | APOIO_PENDENTE
  // APOIO_PENDENTE = DPO precisa do setor X pra avaliar; conta como respondida
  // (libera Fases 5/6/7 no guard) mas é ignorada no cálculo do score.
  resposta      String
  justificativa String?
  setorApoio    String? // só preenchido quando resposta=APOIO_PENDENTE (TI|JURIDICO|...)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, controleId])
  @@index([companyId])
  @@map("gap_answers")
}

// -----------------------------------------------------------------------------
// MINI-APP 4 — PLANO DE AÇÃO (simplificado, alimentado por Riscos)
// -----------------------------------------------------------------------------

model ActionPlan {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  origem      String // RISCO | GAP | DIAGNOSTICO | MANUAL
  origemRef   String? // id do risco/gap relacionado
  acao        String
  responsavel String?
  prazo       DateTime?
  status      String    @default("ABERTA") // ABERTA | EM_ANDAMENTO | CONCLUIDA
  prioridade  String? // BAIXA | MEDIA | ALTA
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@map("action_plans")
}

// -----------------------------------------------------------------------------
// MINI-APP 5 — POLÍTICAS (Política do PGP automática + Aviso de Privacidade)
// -----------------------------------------------------------------------------

// === Aviso de Privacidade — campos pedagógicos extras ===
// Adicionados via migration `/api/curso/migrar-aviso-erros`:
//   - errosReportados Json?     (lista de {grupoUserName, descricao, criadoEm})
//   - autoErrosPlantados String[] (IDs dos erros que o auto-preencher injetou)
// Mantidos no model Policy abaixo (não houve criação de nova tabela).

model Policy {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slug        String // "aviso-privacidade" | "politica-pgp"
  titulo      String
  conteudoMd  String    @db.Text
  status      String    @default("RASCUNHO") // RASCUNHO | PUBLICADO
  publicSlug  String?   @unique
  publishedAt DateTime?
  // IDs dos erros pedagógicos plantados pelo "auto-preencher" (Missão 4b).
  // Lista do catálogo em `lib/aviso-erros-plantados.ts`. Facilitador vê os
  // grupos que detectaram OU passaram batido. Vazio = aviso não foi
  // auto-preenchido ou foi com plantarErros=false.
  autoErrosPlantados String[] @default([])
  // Reportes do grupo: lista de {userName, descricao, criadoEm} em JSON.
  // Pedagógico: facilitador lê no debrief e classifica oralmente (igual
  // padrão "Outros" do DSR Surpresa).
  errosReportados Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions PolicyVersion[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("policies")
}

model PolicyVersion {
  id         String   @id @default(cuid())
  policyId   String
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  numero     Int
  conteudoMd String   @db.Text
  changelog  String?
  createdAt  DateTime @default(now())

  @@unique([policyId, numero])
  @@map("policy_versions")
}

// -----------------------------------------------------------------------------
// MINI-APP 6 — INCIDENTES
// -----------------------------------------------------------------------------

model Incident {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  titulo            String
  descricao         String?
  severidade        String    @default("MEDIA") // BAIXA | MEDIA | ALTA | CRITICA
  status            String    @default("RASCUNHO") // RASCUNHO | EM_ANALISE | ENCERRADO
  ocorridoEm        DateTime?
  detectadoEm       DateTime?
  comunicadoAnpd    Boolean   @default(false)
  comunicadoTitular Boolean   @default(false)
  // === Formulários estruturados (Missão 5) ===
  // Resposta a incidente é processo rápido — DPO usa celular em campo.
  // Em vez de download de DOCX/TXT, formulário inline com opções pré-mapeadas
  // (checkboxes) que aceleram o preenchimento. Pedagógico: a equipe precisa
  // estar PREPARADA com antecedência — opções já no app reforçam o "pense no
  // PRI antes do incidente acontecer".
  // Estrutura: { naturezaDados: string[], titularesNumero: string,
  //   titularesCategorias: string[], medidasTecnicas: string[],
  //   riscos: string[], medidasMitigacao: string[], motivoAtraso: string }
  formularioAnpd       Json?
  // Estrutura: { dadosAfetados: string[], oQueFizemos: string[] }
  formularioTitulares  Json?
  // Fatores objetivos da classificação de severidade (Frente 2 — PRI).
  // { houveAcesso, sensivel, vulneravel, volume, exposicao } — calcula a
  // severidade via lib/incidente-severidade.ts. Auto-migração.
  severidadeFatores    Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  inventoryLinks IncidentInventoryLink[]
  operatorLinks  IncidentOperatorLink[]

  @@index([companyId])
  @@map("incidents")
}

model IncidentInventoryLink {
  id          String        @id @default(cuid())
  incidentId  String
  incident    Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  inventoryId String
  inventory   DataInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([incidentId, inventoryId])
  @@map("incident_inventory_links")
}

model IncidentOperatorLink {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@unique([incidentId, operatorId])
  @@map("incident_operator_links")
}

// === Plano de Resposta a Incidentes (PRI) — Missão 5 preparação ===
// Lição central: equipe TEM que estar preparada COM ANTECEDÊNCIA. PRI é o
// manual de bombeiro — define QUEM faz O QUÊ ANTES do incidente acontecer.

// Membro da Equipe de Tratamento de Incidentes (ETIR/CSIRT)
model PriMembroEquipe {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nome        String
  papel       String  // DPO | TI | JURIDICO | COMUNICACAO | ALTA_GESTAO | DONO_PROCESSO
  contato24h  String? // telefone celular, idealmente WhatsApp
  email       String?
  cobertura   String? // ex: "primário", "backup quando férias do DPO"
  observacao  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@map("pri_membros_equipe")
}

// Matriz RACI por etapa NIST. Define qual papel é R/A/C/I em cada etapa.
// Pode ter VÁRIOS responsáveis/consultados/informados pra mesma etapa.
model PriRaci {
  id         String  @id @default(cuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  etapaNist  String  // DETECTAR | CONTER | ERRADICAR | RECUPERAR | LICOES
  papel      String  // mesmo enum do PriMembroEquipe
  tipo       String  // R (responsável) | A (aprovador) | C (consultado) | I (informado)
  createdAt  DateTime @default(now())

  @@unique([companyId, etapaNist, papel, tipo])
  @@index([companyId])
  @@map("pri_raci")
}

// -----------------------------------------------------------------------------
// MINI-APP 7 — RIPD
// -----------------------------------------------------------------------------

model Ripd {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  titulo       String
  inventoryRef String? // referência ao processo
  status       String    @default("RASCUNHO") // RASCUNHO | SUBMETIDO | APROVADO | DEVOLVIDO
  feedbackDpo  String? // motivo da devolução pelo DPO
  createdById  String?
  reviewedById String?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime @updatedAt

  sections RipdSection[]

  @@index([companyId])
  @@map("ripds")
}

model RipdSection {
  id        String   @id @default(cuid())
  ripdId    String
  ripd      Ripd     @relation(fields: [ripdId], references: [id], onDelete: Cascade)
  numero    Int // 1 a 8 (seções ANPD)
  titulo    String
  conteudo  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ripdId, numero])
  @@map("ripd_sections")
}

// -----------------------------------------------------------------------------
// MINI-APP 8 — GESTÃO DE TERCEIROS (Operadores)
// -----------------------------------------------------------------------------

model Operator {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nome      String
  cnpj      String?
  servico   String?
  papel     String?  @default("OPERADOR") // OPERADOR | CONTROLADOR | CONJUNTO
  contato   String?
  // Tramitação multi-setor (Comitê LGPD): o DPO pede parecer a TI/Jurídico/etc.
  // sobre o terceiro. O setor de apoio responde em tramitacaoParecer (Opção B —
  // dá parecer, não edita). Auto-migração via lib/colunas-tramitacao-operador.ts.
  tramitadoPara     String?
  tramitacaoNota    String?
  tramitadoEm       DateTime?
  tramitacaoParecer String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts     OperatorContract[]
  incidentLinks IncidentOperatorLink[]

  @@index([companyId])
  @@map("operators")
}

model OperatorContract {
  id             String    @id @default(cuid())
  operatorId     String
  operator       Operator  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  numero         String?
  objeto         String?
  vigenciaInicio DateTime?
  vigenciaFim    DateTime?
  clausulasLgpd  Boolean   @default(false)
  observacao     String?
  // === Pedagógico ===
  // Tipo de operação contratual (define o caminho da adequação):
  //   ADITIVO_NECESSARIO     — contrato antigo sem cláusulas LGPD → aditamento
  //   CONTRATO_NOVO_CLAUSULAS — contrato novo sendo redigido → cláusulas direto
  //   RENOVACAO_ADITIVAR     — em renovação → aprovado com aditivo de LGPD
  //   CONTRATO_NOVO_ALTO_RISCO — novo + alto risco (sensíveis/larga escala) → cláusulas robustas
  tipoOperacao   String?
  // Nível de risco do operador (Resolução ANPD nº 2/2022 — critérios gerais
  // e específicos da régua). Calculado/sugerido no seed; pode ser ajustado
  // pelo DPO. Valores: BAIXO | MEDIO | ALTO.
  nivelRisco     String?
  // IDs das cláusulas selecionadas pelo DPO pra incluir no aditamento DOCX.
  // Cada ID corresponde a uma entrada no catálogo `lib/clausulas-lgpd.ts`.
  clausulasSelecionadas String[] @default([])
  // === Análise de Risco (Res. ANPD nº 2/2022, art. 4º) ===
  // IDs dos fatores de risco marcados pelo DPO. Cada ID vem do catálogo
  // `lib/risco-anpd.ts`. Ex: ["GERAL_LARGA_ESCALA", "ESPECIFICO_SENSIVEIS"].
  // O nivelRisco final é calculado a partir desses fatores.
  riscoFatoresMarcados  String[] @default([])
  // === Due Diligence (questionário de avaliação Cyber+LGPD) ===
  // Mapa pergunta_id → "S" | "N" | "NA". Catálogo em `lib/due-diligence.ts`.
  // Score (% de aderência) é calculado sob demanda.
  dueDiligenceRespostas Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("operator_contracts")
}

// -----------------------------------------------------------------------------
// MINI-APP 9 — DIREITOS DO TITULAR (DSR)
// -----------------------------------------------------------------------------

model DsrRequest {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  titularNome     String
  titularContato  String
  tipoSolicitacao String // ACESSO | CORRECAO | EXCLUSAO | PORTABILIDADE | OPOSICAO | INFO | OUTRO
  descricao       String?
  status          String    @default("ABERTA") // ABERTA | EM_ANALISE | RESPONDIDA | NEGADA
  respostaTexto   String?   @db.Text
  respondidoEm    DateTime?
  // DSR Surpresa (Missão 4a) — facilitador dispara pedidos falsos
  disparoFacilitador Boolean @default(false)
  // CONFIRMATION_REQUESTED | RESPONDED_AFTER_CONFIRMATION | RESPONDED_WITHOUT_CONFIRMATION | DENIED_NO_ID
  gameAction      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@map("dsr_requests")
}
