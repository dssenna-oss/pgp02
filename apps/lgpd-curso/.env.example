# =============================================================================
# PGP Treinamento — app de curso presencial LGPD (Modalidade A)
# =============================================================================
# Cópia: cp .env.example .env.local  e preencha os 3 valores abaixo.
# Não commita .env nem .env.local.
# =============================================================================

# Connection string da branch Neon "curso" (NÃO usar branch main de prod!)
# Criar em: https://console.neon.tech → projeto → Branches → "+ New branch"
DATABASE_URL="postgresql://USER:PASS@HOST/curso?sslmode=require"

# Segredo do NextAuth — gerar novo via:  openssl rand -base64 32
NEXTAUTH_SECRET="GERAR_NOVO_SEGREDO"

# URL pública do app
# Dev local:  http://localhost:3100
# Produção:   https://lgpd-curso.vercel.app
NEXTAUTH_URL="http://localhost:3100"

# Email do admin/facilitador (acesso ao painel /admin)
# Default usado pelo seed inicial — pode ser alterado depois.
ADMIN_EMAIL="facilitador@curso.lgpd"
ADMIN_PASSWORD="Curso2026!"
