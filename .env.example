# ============================================
# PGP - Programa de Governança em Privacidade
# Variáveis de Ambiente
# ============================================

# --- Banco de Dados (PostgreSQL) ---
# URL de conexão com o banco PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/pgp_database?schema=public

# --- NextAuth.js (Autenticação) ---
# Secret para assinar tokens JWT (gere com: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-key-here
# URL base da aplicação (ajuste conforme o ambiente)
NEXTAUTH_URL=http://localhost:3000

# --- Seed (admin inicial) ---
# Credenciais usadas pelo `prisma db seed` ao popular o banco.
# NÃO commite valores reais — defina apenas no .env local (gitignored).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme-dev-only

# --- Google Gemini (LLM do chatbot Detetive da Privacidade) ---
# Crie uma chave em: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-api-key-here
# Modelo (opcional). Default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# --- AWS S3 (Upload de arquivos) ---
# Nome do bucket S3 para armazenamento de arquivos
AWS_BUCKET_NAME=your-bucket-name
# Prefixo de pasta dentro do bucket
AWS_FOLDER_PREFIX=pgp/
# Região AWS do bucket
AWS_REGION=us-east-1
# Perfil AWS (opcional, para credenciais locais)
AWS_PROFILE=default
